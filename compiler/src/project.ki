// kite.toml / kite.lock handling and project discovery (port of project.rs).

use sysx

type Manifest:
    name: string
    version: string
    edition: string
    opt_level: int
    target: string
    dep_names: [string]
    dep_vers: [string]

type Project:
    root: string
    manifest: Manifest

make unquote(s: string) -> string:
    t = trim(s)
    if len(t) >= 2 and char_at(t, 0) == 34 and char_at(t, len(t) - 1) == 34:
        return substr(t, 1, len(t) - 1)
    return t

make new_manifest(name: string) -> Manifest:
    m = Manifest()
    m.name = name
    m.version = "0.1.0"
    m.edition = "2026"
    return m

// Minimal TOML reader: `[section]` headers and `key = value` lines (strings and integers).
make manifest_parse(text: string) -> Manifest:
    m = new_manifest("")
    m.version = ""
    section = ""
    for raw in split(text, "\n"):
        line = trim(raw)
        if len(line) == 0 or starts_with(line, "#"):
            continue
        if starts_with(line, "["):
            section = trim(substr(line, 1, len(line) - 1))
            continue
        eq = find(line, "=")
        if eq < 0:
            continue
        key = trim(substr(line, 0, eq))
        val = unquote(substr(line, eq + 1, len(line)))
        if section == "package":
            if key == "name":
                m.name = val
            orif key == "version":
                m.version = val
            orif key == "edition":
                m.edition = val
        orif section == "build":
            if key == "opt_level":
                m.opt_level = to_int(val)
            orif key == "target":
                m.target = val
        orif section == "dependencies":
            append(m.dep_names, key)
            append(m.dep_vers, val)
    return m

make manifest_to_string(m: Manifest) -> string:
    deps = ""
    if len(m.dep_names) == 0:
        deps = "# Run `kite add <package>` to add one.\n"
    else:
        i = 0
        while i < len(m.dep_names):
            deps = deps + m.dep_names[i] + " = \"" + m.dep_vers[i] + "\"\n"
            i += 1
    return "[package]\nname = \"" + m.name + "\"\nversion = \"" + m.version + "\"\nedition = \"" + m.edition + "\"\n\n[build]\nopt_level = " + str(m.opt_level) + "\n\n[dependencies]\n" + deps

// BTreeMap order: dependencies sorted by name.
make manifest_sorted(m: Manifest) -> Manifest:
    out = new_manifest(m.name)
    out.version = m.version
    out.edition = m.edition
    out.opt_level = m.opt_level
    out.target = m.target
    names: [string] = []
    for n in m.dep_names:
        append(names, n)
    // insertion sort
    i = 1
    while i < len(names):
        j = i
        while j > 0 and names[j - 1] > names[j]:
            tmp = names[j]
            names[j] = names[j - 1]
            names[j - 1] = tmp
            j -= 1
        i += 1
    for n2 in names:
        k = 0
        while k < len(m.dep_names):
            if m.dep_names[k] == n2:
                append(out.dep_names, n2)
                append(out.dep_vers, m.dep_vers[k])
            k += 1
    return out

make lock_to_string(m: Manifest) -> string:
    out = "# This file is automatically generated by `kite`.\n# Do not edit it by hand.\n\n"
    s = manifest_sorted(m)
    i = 0
    while i < len(s.dep_names):
        out = out + "[[package]]\nname = \"" + s.dep_names[i] + "\"\nversion = \"" + s.dep_vers[i] + "\"\n\n"
        i += 1
    return out

// Walks up from `start` to the directory holding kite.toml.
make project_discover(start: string) -> Project:
    p = Project()
    dir = start
    while true:
        cand = path_join(dir, "kite.toml")
        if file_exists(cand):
            p.root = dir
            p.manifest = manifest_parse(read_file(cand))
            return p
        parent = path_parent(dir)
        if parent == "" or parent == dir:
            die("could not find `kite.toml` in `" + start + "` or any parent directory\n(run `kite init` to create a new project)")
            return p
        dir = parent
    return p

make project_main_path(p: Project) -> string:
    return path_join(path_join(p.root, "src"), "main.ki")

make project_src_dir(p: Project) -> string:
    return path_join(p.root, "src")

make project_build_dir(p: Project) -> string:
    return path_join(p.root, "target")

make project_output_path(p: Project) -> string:
    return path_join(project_build_dir(p), p.manifest.name)

make project_save(p: Project):
    write_file(path_join(p.root, "kite.toml"), manifest_to_string(manifest_sorted(p.manifest)))
    write_file(path_join(p.root, "kite.lock"), lock_to_string(p.manifest))
