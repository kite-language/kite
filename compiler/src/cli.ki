// The `kite` command line (port of main.rs, cli.rs and commands/*).

use diag
use ast
use irdef
use sysx
use project
use resolve
use driver
use cheader
use pieces
use targets
use devtools

make version_text() -> string:
    return "0.4.1"

make usage() -> string:
    out = "The Kite programming language compiler and project manager\n\n"
    out = out + "Usage: kite <COMMAND>\n\nCommands:\n"
    out = out + "  init    Create a new Kite project (`--lib` for a piece) in a new directory or the current one\n"
    out = out + "  build   Compile the project to a native executable\n"
    out = out + "  run     Build, then run the project\n"
    out = out + "  check   Type-check without producing a binary\n"
    out = out + "  clean   Remove the build directory\n"
    out = out + "  bench   Build in release mode and time repeated runs\n"
    out = out + "  add     Record a dependency in kite.toml\n"
    out = out + "  remove  Remove a dependency from kite.toml\n"
    out = out + "  update  Re-resolve the dependencies and refresh kite.lock\n"
    out = out + "  tree    Print the dependency tree\n"
    out = out + "  search  Search the piece registry\n"
    out = out + "  info    Show a piece's metadata\n"
    out = out + "  publish Validate a piece and prepare its pull request to the registry\n"
    out = out + "  verify  Check a piece the way the registry CI does\n"
    out = out + "  target  Manage build targets (list, add, remove, show)\n"
    out = out + "  test    Build and run tests/*.ki (non-zero exit code = failure)\n"
    out = out + "  fmt     Normalise whitespace in src/ and tests/ (`--check` only reports)\n"
    out = out + "  doc     Generate target/doc/<name>.md from the `//` comments above items\n"
    out = out + "  help    Print this message\n\n"
    out = out + "Options:\n  -h, --help     Print help\n  -V, --version  Print version\n"
    return out

make now_ns() -> int:
    return to_int(trim(capture("date +%s%N")))

// seconds with two decimals from a nanosecond duration
make fmt_secs(ns: int) -> string:
    cs = (ns + 5000000) / 10000000
    frac = cs % 100
    fs = str(frac)
    if frac < 10:
        fs = "0" + fs
    return str(cs / 100) + "." + fs

// milliseconds with three decimals from a microsecond count
make fmt_ms(us: int) -> string:
    frac = us % 1000
    fs = str(frac)
    while len(fs) < 3:
        fs = "0" + fs
    return str(us / 1000) + "." + fs

make isqrt(n: int) -> int:
    if n <= 0:
        return 0
    x = n
    y = (x + 1) / 2
    while y < x:
        x = y
        y = (x + n / x) / 2
    return x

class Args:
    items: [string]
    pos: int

    make done(self) -> bool:
        return self.pos >= len(self.items)

    make next(self) -> string:
        v = self.items[self.pos]
        self.pos += 1
        return v

    make value(self, flag: string) -> string:
        if self.pos >= len(self.items):
            die("a value is required for '" + flag + "' but none was supplied")
        return self.next()

class BuildOpts:
    target: string
    release: bool
    quiet: bool
    mode: string
    static_link: bool
    output: string
    out_dir: string
    links: [string]

make git_config(key: string) -> string:
    return trim(capture("git config " + key))

make cmd_init(name: string, has_name: bool, lib: bool):
    project_dir = ""
    package_name = ""
    creating = has_name
    if has_name:
        project_dir = name
        package_name = path_file_name(name)
        if package_name == "":
            package_name = name
    else:
        project_dir = cwd()
        package_name = path_file_name(project_dir)
        if package_name == "":
            package_name = "kite_project"
    if lib and not valid_piece_name(package_name):
        die("`" + package_name + "` is not a valid piece name (lowercase letters, digits, `_` and `-`, starting with a letter)")
    if creating:
        if file_exists(project_dir):
            die("destination `" + project_dir + "` already exists; choose a different name or `cd` into it and rerun without one")
        if not mkdir_all(project_dir):
            die("failed to create directory " + project_dir)
    manifest_path = path_join(project_dir, "kite.toml")
    if file_exists(manifest_path):
        die("`kite.toml` already exists in `" + project_dir + "` -- this is already a Kite project")
    m = new_manifest(package_name)
    gname = git_config("user.name")
    gmail = git_config("user.email")
    if len(gname) > 0:
        m.authors = gname
        if len(gmail) > 0:
            m.authors = gname + " <" + gmail + ">"
    if lib:
        m.description = "A Kite piece"
        m.license = "MIT"
    write_file(manifest_path, manifest_to_string(m))
    src_dir = path_join(project_dir, "src")
    mkdir_all(src_dir)
    if lib:
        ident = replace_all(package_name, "-", "_")
        write_file(path_join(src_dir, "lib.ki"), "// Functions of a piece share one global namespace: prefix them with the piece name.\nmake " + ident + "_hello() -> string:\n    return \"Hello from " + package_name + "!\"\n")
    else:
        write_file(path_join(src_dir, "main.ki"), "make main():\n    print(\"Hello, Kite!\")\n")
    gi = path_join(project_dir, ".gitignore")
    if not file_exists(gi):
        write_file(gi, "/target\n/.kite-cache\n")
    label = ""
    if creating:
        label = "new"
    kind = "package"
    if lib:
        kind = "piece"
    status("Created", label + " " + kind + " `" + package_name + "`")
    if creating:
        print("       cd " + project_dir + " && kite build")
    else:
        print("       kite build")

// Kite source of the package-metadata accessors (`pkg_name()`, ...), compiled in only when used.
make pkg_meta_source(m: Manifest) -> string:
    out = ""
    out = out + "make pkg_name() -> string:\n    return " + quote_toml(m.name) + "\n\n"
    out = out + "make pkg_version() -> string:\n    return " + quote_toml(m.version) + "\n\n"
    out = out + "make pkg_edition() -> string:\n    return " + quote_toml(m.edition) + "\n\n"
    out = out + "make pkg_description() -> string:\n    return " + quote_toml(m.description) + "\n\n"
    out = out + "make pkg_authors() -> string:\n    return " + quote_toml(m.authors) + "\n\n"
    out = out + "make pkg_license() -> string:\n    return " + quote_toml(m.license) + "\n\n"
    out = out + "make pkg_repository() -> string:\n    return " + quote_toml(m.repository) + "\n\n"
    out = out + "make pkg_homepage() -> string:\n    return " + quote_toml(m.homepage) + "\n\n"
    out = out + "make pkg_keywords() -> string:\n    return " + quote_toml(m.keywords) + "\n\n"
    return out

// Resolves the dependencies, (re)writes kite.lock when it changed, and returns the pieces.
make prepare_deps(p: Project, write_lock: bool) -> Resolved:
    reg = registry_dir(p.root)
    r = resolve_all(p, reg)
    verify_lock(p, r)
    if write_lock and (len(r.names) > 0 or file_exists(path_join(p.root, "kite.lock"))):
        lock = lock_text(r)
        lp = path_join(p.root, "kite.lock")
        if read_file(lp) != lock:
            write_file(lp, lock)
    return r

make make_ctx(p: Project, r: Resolved) -> Ctx:
    cx = Ctx()
    cx.registry = r.registry
    cx.piece_names = r.names
    cx.piece_roots = r.roots
    cx.meta_src = pkg_meta_source(p.manifest)
    return cx

make profile_label(release: bool) -> string:
    if release:
        return "release [optimized]"
    return "dev [unoptimized]"

make build_run(o: BuildOpts) -> string:
    p = project_discover(cwd())
    r = prepare_deps(p, true)
    cx = make_ctx(p, r)
    entry = project_main_path(p)
    src_root = project_src_dir(p)
    if not is_file(entry):
        die("`" + entry + "` not found -- does this project have a `src/main.ki` (or `src/lib.ki`)?")
    opt = p.manifest.opt_level
    if o.release:
        opt = 3
    target = o.target
    if target == "":
        target = p.manifest.target
    mode = o.mode
    spec = target_spec(target)
    triple = target
    if len(target) > 0:
        triple = spec.triple
        if spec.kind == "bare":
            if not target_installed(target):
                die("target `" + target + "` is not installed: run `kite target add " + target + "`")
            mode = "bare-link"
    profile_dir = project_profile_dir(p, o.release)
    if len(target) > 0:
        profile_dir = path_join(path_join(project_build_dir(p), target), pick(o.release, "release", "debug"))
    default_path = path_join(profile_dir, p.manifest.name)
    base = default_path
    if o.output != "":
        base = o.output
    orif o.out_dir != "":
        base = path_join(o.out_dir, p.manifest.name)
    out_path = base
    if mode == "bare-link" and not path_has_extension(base):
        out_path = path_with_extension(base, "elf")
    orif (mode == "freestanding" or mode == "lib") and not path_has_extension(base):
        out_path = path_with_extension(base, "o")
    orif mode == "exe":
        out_path = normalized_executable_path(base, triple)
    mode_label = ""
    if mode == "freestanding":
        mode_label = " [freestanding]"
    orif mode == "lib":
        mode_label = " [lib]"
    orif mode == "bare-link":
        mode_label = " [" + target + "]"
    if mode == "exe":
        cx.fp_file = path_join(path_join(profile_dir, ".fingerprint"), p.manifest.name)
        cx.out_file = out_path
        cx.flags = "kite " + version_text() + " opt=" + str(opt) + " target=" + triple + " static=" + str(o.static_link) + " links=" + join(o.links, ",")
    start = now_ns()
    c = check_project_with_ui(p, r, entry, src_root, mode != "exe", cx, o.quiet, mode_label)
    header_path = ""
    if not c.fresh:
        mkdir_all(profile_dir)
        if mode == "exe":
            out_path = build_from_ir(c.prog, out_path, opt, triple, "exe", o.static_link, o.links)
            mkdir_all(path_parent(cx.fp_file))
            write_file(cx.fp_file, c.fingerprint)
        orif mode == "freestanding":
            build_from_ir(c.prog, out_path, opt, triple, "bare", false, o.links)
        orif mode == "bare-link":
            obj = path_with_extension(out_path, "o")
            build_from_ir(c.prog, obj, opt, triple, "bare", false, o.links)
            if not link_bare(obj, out_path, spec):
                die("linking `" + out_path + "` failed")
        else:
            build_from_ir(c.prog, out_path, opt, triple, "obj", false, o.links)
            stem = path_file_name(out_path)
            dot = find(stem, ".")
            if dot > 0:
                stem = substr(stem, 0, dot)
            header = generate_c_header(stem, c.ast, c.root)
            header_path = path_with_extension(out_path, "h")
            if not write_file(header_path, header):
                die("failed to write C header to " + header_path)
    elapsed = now_ns() - start
    if not o.quiet:
        extra = ""
        if mode == "freestanding":
            extra = " -> " + out_path + " (object file, not linked)"
        orif mode == "lib":
            extra = " -> " + out_path + " + " + header_path + " (object file + C header)"
        orif mode == "bare-link":
            extra = " -> " + out_path
        status("Finished", profile_label(o.release) + " target(s) in " + fmt_secs(elapsed) + "s" + extra)
    return out_path

// The front end with the cargo-like progress lines: one `Compiling` line per piece, then the package.
make check_project_with_ui(p: Project, r: Resolved, entry: string, src_root: string, no_main: bool, cx: Ctx, quiet: bool, mode_label: string) -> Checked:
    c = check_project(entry, src_root, no_main or project_is_lib(p), cx)
    if not c.ok:
        die("aborting build due to previous error(s)")
    if not quiet:
        verb = "Compiling"
        if c.fresh:
            verb = "Fresh"
        i = 0
        while i < len(r.names):
            status(verb, r.names[i] + " v" + r.versions[i] + " (" + r.roots[i] + ")")
            i += 1
        status(verb, p.manifest.name + " v" + p.manifest.version + " (" + p.root + ")" + mode_label)
    return c

make parse_build_args(a: Args, allow_all: bool) -> BuildOpts:
    o = BuildOpts()
    o.mode = "exe"
    while not a.done():
        f = a.next()
        if f == "--release":
            o.release = true
        orif f == "--quiet" or f == "-q":
            o.quiet = true
        orif f == "--target":
            o.target = a.value(f)
        orif f == "--freestanding" and allow_all:
            o.mode = "freestanding"
        orif f == "--lib" and allow_all:
            o.mode = "lib"
        orif f == "--static" and allow_all:
            o.static_link = true
        orif (f == "--output" or f == "-o") and allow_all:
            o.output = a.value(f)
        orif f == "--out-dir" and allow_all:
            o.out_dir = a.value(f)
        orif f == "--link" and allow_all:
            append(o.links, a.value(f))
        else:
            die("unexpected argument '" + f + "' found")
    return o

make cmd_check(quiet: bool):
    p = project_discover(cwd())
    if not quiet:
        status("Checking", p.manifest.name + " v" + p.manifest.version + " (" + p.root + ")")
    r = prepare_deps(p, false)
    entry = project_main_path(p)
    if not is_file(entry):
        die("`" + entry + "` not found -- does this project have a `src/main.ki` (or `src/lib.ki`)?")
    c = check_project(entry, project_src_dir(p), project_is_lib(p), make_ctx(p, r))
    if not c.ok:
        die("aborting due to previous error(s)")
    if not quiet:
        status("Checked", "no errors found")

make cmd_clean():
    p = project_discover(cwd())
    bd = project_build_dir(p)
    if file_exists(bd):
        remove_dir_all(bd)
        status("Removed", bd)
    else:
        status("Clean", "nothing to clean")

make cmd_add(spec: string):
    p = project_discover(cwd())
    name = spec
    req = "*"
    at = find(spec, "@")
    if at >= 0:
        name = substr(spec, 0, at)
        req = substr(spec, at + 1, len(spec))
    if name == "":
        die("piece name cannot be empty")
    reg = registry_dir(p.root)
    vers = registry_versions(reg, name)
    if len(vers) == 0:
        if len(std_versions(reg, name)) > 0:
            die("`" + name + "` is a default piece: it needs no dependency, write `use std." + name + "`")
        die("piece `" + name + "` was not found in the registry" + hint_registry(reg))
    best = sv_best(vers, req)
    if len(best) == 0:
        die("no version of `" + name + "` satisfies `" + req + "` (available: " + join(vers, ", ") + ")")
    written = req
    if req == "*":
        written = best
    existed = manifest_dep_index(p.manifest, name) >= 0
    project_save_text(p, manifest_text_set_dep(p.text, name, quote_toml(written)))
    p.manifest = manifest_parse(p.text)
    prepare_deps(p, true)
    verb = "Added"
    if existed:
        verb = "Updated"
    status(verb, name + " v" + best + " to dependencies")

make cmd_remove(name: string):
    p = project_discover(cwd())
    if manifest_dep_index(p.manifest, name) < 0:
        die("piece `" + name + "` is not a dependency of `" + p.manifest.name + "`")
    project_save_text(p, manifest_text_remove_dep(p.text, name))
    p.manifest = manifest_parse(p.text)
    prepare_deps(p, true)
    status("Removed", name)

make cmd_update():
    p = project_discover(cwd())
    reg = registry_dir(p.root)
    r = resolve_all(p, reg)
    write_file(path_join(p.root, "kite.lock"), lock_text(r))
    if len(r.names) == 0:
        status("Update", "no dependencies to update")
    else:
        i = 0
        while i < len(r.names):
            status("Locked", r.names[i] + " v" + r.versions[i])
            i += 1

make cmd_tree():
    p = project_discover(cwd())
    print_tree(p, resolve_all(p, registry_dir(p.root)))

make search_tier(reg: string, tier: string, query: string) -> int:
    found = 0
    tdir = tier_dir(reg, tier)
    if not is_dir(tdir):
        return 0
    for name in list_dir(tdir):
        vers = registry_versions_in(reg, tier, name)
        if len(vers) == 0:
            continue
        best = sv_best(vers, "*")
        m = read_manifest_at(path_join(path_join(tdir, name), best))
        if query == "" or contains_str(name, query) or contains_str(m.description, query) or contains_str(m.keywords, query):
            if tier == "std":
                print(fmt_pad("std." + name, 18) + " " + best + "    # " + m.description + "  [default piece]")
            else:
                print(fmt_pad(name, 18) + " = \"" + best + "\"    # " + m.description)
            found += 1
    return found

make cmd_search(query: string):
    reg = registry_dir(cwd())
    if len(reg) == 0:
        die("no registry found" + hint_registry(reg))
    found = search_tier(reg, "std", query) + search_tier(reg, "community", query)
    if found == 0:
        print("no pieces found")

make fmt_pad(s: string, w: int) -> string:
    if len(s) >= w:
        return s
    return s + repeat(" ", w - len(s))

make cmd_info(name: string):
    reg = registry_dir(cwd())
    tier = "community"
    vers = registry_versions(reg, name)
    if len(vers) == 0:
        tier = "std"
        vers = std_versions(reg, name)
    if len(vers) == 0:
        die("piece `" + name + "` was not found in the registry" + hint_registry(reg))
    best = sv_best(vers, "*")
    m = read_manifest_at(path_join(path_join(tier_dir(reg, tier), name), best))
    if tier == "std":
        print("std." + name + " v" + best + "  (default piece: `use std." + name + "`)")
    else:
        print(name + " v" + best)
    print("description: " + m.description)
    print("authors:     " + m.authors)
    print("license:     " + m.license)
    print("repository:  " + m.repository)
    print("homepage:    " + m.homepage)
    print("keywords:    " + m.keywords)
    print("versions:    " + join(vers, ", "))
    deps: [string] = []
    i = 0
    while i < len(m.dep_names):
        append(deps, m.dep_names[i] + " " + m.dep_vers[i])
        i += 1
    print("dependencies: " + join(deps, ", "))

// Piece rules shared by `publish` and `verify`; dies with the first problem.
make validate_piece(p: Project):
    m = p.manifest
    if not project_is_lib(p):
        die("a piece is a library: it has `src/lib.ki` and no `src/main.ki`")
    if not file_exists(path_join(path_join(p.root, "src"), "lib.ki")):
        die("`src/lib.ki` not found")
    if not valid_piece_name(m.name):
        die("`" + m.name + "` is not a valid piece name (lowercase letters, digits, `_` and `-`, starting with a letter)")
    if len(std_versions(registry_dir(p.root), m.name)) > 0 and not path_contains_tier(p.root, "std"):
        die("`" + m.name + "` is the name of a default piece: choose another name")
    if not sv_parse(m.version).ok:
        die("`version = \"" + m.version + "\"` is not a valid semantic version (e.g. 0.1.0)")
    if len(trim(m.description)) == 0:
        die("`description` is required in [package]")
    if len(trim(m.license)) == 0:
        die("`license` is required in [package]")
    if len(trim(m.authors)) == 0:
        die("`authors` is required in [package]")
    i = 0
    while i < len(m.dep_names):
        if len(m.dep_paths[i]) > 0:
            die("dependency `" + m.dep_names[i] + "` is a path dependency; published pieces may only depend on registry pieces")
        i += 1

// Whether `root` is `.../<tier>/<name>/<version>` of a registry.
make path_contains_tier(root: string, tier: string) -> bool:
    return path_file_name(path_parent(path_parent(root))) == tier

make verify_compiles(p: Project):
    r = prepare_deps(p, false)
    c = check_project(project_main_path(p), project_src_dir(p), true, make_ctx(p, r))
    if not c.ok:
        die("the piece does not compile")

make cmd_verify():
    p = project_discover(cwd())
    validate_piece(p)
    status("Verifying", p.manifest.name + " v" + p.manifest.version)
    // when inside a registry (`.../<name>/<version>`), the directory names must match the manifest
    ver_dir = path_file_name(p.root)
    name_dir = path_file_name(path_parent(p.root))
    if file_exists(path_join(path_parent(path_parent(path_parent(p.root))), "REGISTRY")):
        if ver_dir != p.manifest.version or name_dir != p.manifest.name:
            die("registry path `" + name_dir + "/" + ver_dir + "` does not match kite.toml (" + p.manifest.name + " " + p.manifest.version + ")")
    verify_compiles(p)
    status("Verified", "no problems found")

make cmd_publish():
    p = project_discover(cwd())
    validate_piece(p)
    status("Verifying", p.manifest.name + " v" + p.manifest.version)
    verify_compiles(p)
    reg = trim(capture("printf %s \"$KITE_PIECES\""))
    if reg == "" or not file_exists(path_join(reg, "REGISTRY")):
        die("set KITE_PIECES to the `pieces/` directory of your clone of the Kite repository (the registry lives there)")
    name = p.manifest.name
    version = p.manifest.version
    dest = registry_piece_root(reg, name, version)
    if file_exists(dest):
        die("`" + name + " " + version + "` already exists in the registry: published versions are immutable, bump `version`")
    mkdir_all(dest)
    cmd = "(cd " + shell_quote(p.root) + " && tar --exclude=./target --exclude=./.git --exclude=./kite.lock -cf - .) | (cd " + shell_quote(dest) + " && tar -xf -)"
    if sh(cmd) != 0:
        die("failed to copy the piece into the registry")
    status("Prepared", dest)
    print("")
    print("Nothing was committed. To submit the piece, run in your clone of the repository:")
    print("    git checkout -b piece/" + name + "-" + version)
    print("    git add " + dest)
    print("    git commit -m \"piece: add " + name + " " + version + "\"")
    print("    git push -u origin HEAD")
    print("    gh pr create --title \"piece: add " + name + " " + version + "\" --body \"" + p.manifest.description + "\"")
    print("CI (`scripts/verify-pieces.sh`) checks that it compiles and that no existing version changed.")

make cmd_run(o: BuildOpts):
    binary = build_run(o)
    if not o.quiet:
        status("Running", "`" + binary + "`")
    code = sh(shell_quote(binary))
    exit(code)

make cmd_bench(runs: int, target: string):
    if runs == 0:
        die("--runs must be at least 1")
    o = BuildOpts()
    o.mode = "exe"
    o.release = true
    o.quiet = true
    o.target = target
    binary = build_run(o)
    status("Benchmarking", binary)
    times: [int] = []
    i = 1
    while i <= runs:
        t0 = now_ns()
        code = sh(shell_quote(binary) + " > /dev/null 2>&1")
        t1 = now_ns()
        if code != 0:
            die("run " + str(i) + "/" + str(runs) + " exited with a non-zero status (Some(" + str(code) + ")) -- aborting benchmark")
        append(times, (t1 - t0) / 1000)
        i += 1
    total = 0
    mn = times[0]
    mx = times[0]
    for t in times:
        total += t
        if t < mn:
            mn = t
        if t > mx:
            mx = t
    avg = total / len(times)
    var = 0
    for t2 in times:
        var += (t2 - avg) * (t2 - avg)
    sd = isqrt(var / len(times))
    print("")
    print("Kite benchmark")
    print("       Runs: " + str(runs))
    print("    Average: " + fmt_ms(avg) + " ms")
    print("        Min: " + fmt_ms(mn) + " ms")
    print("        Max: " + fmt_ms(mx) + " ms")
    print("    Std dev: " + fmt_ms(sd) + " ms")

make need_arg(a: Args):
    if a.done():
        die("the following required arguments were not provided: <NAME>")

make cli_main():
    a = Args()
    n = arg_count()
    i = 0
    while i < n:
        append(a.items, arg(i))
        i += 1
    if a.done():
        print(usage())
        exit(2)
    cmd = a.next()
    if cmd == "--version" or cmd == "-V":
        print("kite " + version_text())
    orif cmd == "--help" or cmd == "-h" or cmd == "help":
        print(usage())
    orif cmd == "init":
        lib = false
        nm = ""
        has = false
        while not a.done():
            f0 = a.next()
            if f0 == "--lib" or f0 == "--piece":
                lib = true
            else:
                nm = f0
                has = true
        cmd_init(nm, has, lib)
    orif cmd == "build":
        build_run(parse_build_args(a, true))
    orif cmd == "run":
        cmd_run(parse_build_args(a, false))
    orif cmd == "check":
        q = false
        while not a.done():
            f = a.next()
            if f == "--quiet" or f == "-q":
                q = true
            else:
                die("unexpected argument '" + f + "' found")
        cmd_check(q)
    orif cmd == "clean":
        cmd_clean()
    orif cmd == "add":
        need_arg(a)
        cmd_add(a.next())
    orif cmd == "remove":
        need_arg(a)
        cmd_remove(a.next())
    orif cmd == "update":
        cmd_update()
    orif cmd == "tree":
        cmd_tree()
    orif cmd == "search":
        q2 = ""
        if not a.done():
            q2 = a.next()
        cmd_search(q2)
    orif cmd == "info":
        need_arg(a)
        cmd_info(a.next())
    orif cmd == "publish":
        cmd_publish()
    orif cmd == "verify":
        cmd_verify()
    orif cmd == "test":
        ft = ""
        if not a.done():
            ft = a.next()
        cmd_test(ft)
    orif cmd == "fmt":
        chk = false
        while not a.done():
            f3 = a.next()
            if f3 == "--check":
                chk = true
            else:
                die("unexpected argument '" + f3 + "' found")
        cmd_fmt(chk)
    orif cmd == "doc":
        cmd_doc()
    orif cmd == "target":
        if a.done():
            die("usage: kite target <list|add|remove|show> [NAME]")
        sub = a.next()
        if sub == "list":
            cmd_target_list()
        orif sub == "add":
            need_arg(a)
            cmd_target_add(a.next())
        orif sub == "remove":
            need_arg(a)
            cmd_target_remove(a.next())
        orif sub == "show":
            need_arg(a)
            cmd_target_show(a.next())
        else:
            die("unknown target subcommand `" + sub + "` (list, add, remove, show)")
    orif cmd == "bench":
        runs = 20
        target = ""
        while not a.done():
            f2 = a.next()
            if f2 == "--runs":
                runs = to_int(a.value(f2))
            orif f2 == "--target":
                target = a.value(f2)
            else:
                die("unexpected argument '" + f2 + "' found")
        cmd_bench(runs, target)
    else:
        die("unrecognized subcommand '" + cmd + "'")
