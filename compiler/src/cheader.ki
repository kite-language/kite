// C header generation for `kite build --lib` (port of cheader.rs).

use ast
use types

make c_type(t: string) -> string:
    if t == "int" or ty_is_enum(t):
        return "int64_t"
    if t == "float":
        return "double"
    if t == "bool":
        return "bool"
    if t == "string":
        return "const char*"
    if t == "()":
        return "void"
    if ty_is_ptr(t):
        return c_type(ty_ptr_inner(t)) + "*"
    return "void*"

make sanitize_guard(name: string) -> string:
    out = ""
    for c in range_chars(name):
        out = out + c
    return out

make range_chars(name: string) -> [string]:
    out: [string] = []
    i = 0
    while i < len(name):
        c = char_at(name, i)
        ch = substr(name, i, i + 1)
        if c >= 97 and c <= 122:
            ch = chr(c - 32)
        if is_alnum(c) and c != 95:
            append(out, ch)
        else:
            append(out, "_")
        i += 1
    return out

make generate_c_header(guard_name: string, ast: Ast, root: int) -> string:
    guard = "KITE_" + sanitize_guard(guard_name) + "_H"
    out = "// Generated by `kite build --lib` -- do not edit by hand.\n"
    out = out + "//\n// Declares every Kite function in this library so C code can call it\n"
    out = out + "// directly. See docs/c-interop.md for the full story (type mapping,\n"
    out = out + "// linking, and how to call C from Kite with `extern make ...`).\n\n"
    out = out + "#ifndef " + guard + "\n#define " + guard + "\n\n"
    out = out + "#include <stdint.h>\n#include <stdbool.h>\n\n"
    out = out + "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
    fns = ast.nodes[ast.nodes[root].kids[3]].kids
    for f in fns:
        fk = ast.nodes[f].kids
        if contains_str(ast.nodes[fk[2]].text, "extern"):
            continue
        ret = "void"
        if fk[1] >= 0:
            ret = c_type(ast.nodes[fk[1]].text)
        params: [string] = []
        pl = ast.nodes[fk[0]].kids
        if len(pl) == 0:
            append(params, "void")
        else:
            for p in pl:
                append(params, c_type(ast.nodes[ast.nodes[p].kids[0]].text) + " " + ast.nodes[p].text)
        out = out + ret + " " + ast.nodes[f].text + "(" + join(params, ", ") + ");\n"
    out = out + "\n#ifdef __cplusplus\n}\n#endif\n\n"
    out = out + "#endif // " + guard + "\n"
    return out
