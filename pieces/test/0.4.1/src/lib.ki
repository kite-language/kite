// std.test -- a tiny assertion library.
//
//   t = test_new("my suite")
//   test_eq_int(t, "adds", 1 + 1, 2)
//   test_true(t, "positive", x > 0)
//   exit(test_finish(t))        // prints a summary, returns 0 when everything passed, else 1

class Tester:
    name: string
    passed: int
    failures: int

make test_new(name: string) -> Tester:
    t = Tester()
    t.name = name
    return t

make test_ok(t: Tester, label: string):
    t.passed += 1

make test_fail(t: Tester, label: string, detail: string):
    t.failures += 1
    print("  FAIL " + label + ": " + detail)

make test_true(t: Tester, label: string, cond: bool):
    if cond:
        test_ok(t, label)
    else:
        test_fail(t, label, "expected true")

make test_false(t: Tester, label: string, cond: bool):
    if not cond:
        test_ok(t, label)
    else:
        test_fail(t, label, "expected false")

make test_eq_int(t: Tester, label: string, actual: int, expected: int):
    if actual == expected:
        test_ok(t, label)
    else:
        test_fail(t, label, "expected " + str(expected) + ", got " + str(actual))

make test_eq_str(t: Tester, label: string, actual: string, expected: string):
    if actual == expected:
        test_ok(t, label)
    else:
        test_fail(t, label, "expected \"" + expected + "\", got \"" + actual + "\"")

make test_eq_bool(t: Tester, label: string, actual: bool, expected: bool):
    // (`bool == bool` is not supported by the code generator yet)
    if (actual and expected) or (not actual and not expected):
        test_ok(t, label)
    else:
        test_fail(t, label, "expected " + str(expected) + ", got " + str(actual))

// Prints the summary; returns the process exit code (0 = all passed).
make test_finish(t: Tester) -> int:
    total = t.passed + t.failures
    if t.failures == 0:
        print(t.name + ": " + str(total) + " passed")
        return 0
    print(t.name + ": " + str(t.failures) + " of " + str(total) + " failed")
    return 1
