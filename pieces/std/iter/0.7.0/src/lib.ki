// iter -- working on lists with function values (Kite 0.6+). Generic: the element types are inferred.
//
//   use std.iter
//
//   nums = [1, 2, 3, 4]
//   print(iter.map(nums, |x| x * x))                 // [1, 4, 9, 16]
//   evens = iter.filter(nums, |x| x % 2 == 0)        // [2, 4]
//   print(iter.reduce(nums, 0, |acc, x| acc + x))    // 10
//
// Lambdas capture the variables they use (a copy, taken when the lambda is created).
// Function values take and return int, float, bool, string, pointers and enums.

// A new list with `f` applied to every element.
make iter_map<T, U>(xs: [T], f: fn(T) -> U) -> [U]:
    out: [U] = []
    for x in xs:
        append(out, f(x))
    return out

// The elements for which `keep` is true.
make iter_filter<T>(xs: [T], keep: fn(T) -> bool) -> [T]:
    out: [T] = []
    for x in xs:
        if keep(x):
            append(out, x)
    return out

// `f(f(f(init, x0), x1), x2)...`: folds the list into one value.
make iter_reduce<T, A>(xs: [T], init: A, f: fn(A, T) -> A) -> A:
    acc = init
    for x in xs:
        acc = f(acc, x)
    return acc

// Calls `f` on every element.
make iter_each<T>(xs: [T], f: fn(T)):
    for x in xs:
        f(x)

// True when `test` holds for at least one element.
make iter_any<T>(xs: [T], test: fn(T) -> bool) -> bool:
    for x in xs:
        if test(x):
            return true
    return false

// True when `test` holds for every element (also for an empty list).
make iter_all<T>(xs: [T], test: fn(T) -> bool) -> bool:
    for x in xs:
        if not test(x):
            return false
    return true

// How many elements satisfy `test`.
make iter_count<T>(xs: [T], test: fn(T) -> bool) -> int:
    n = 0
    for x in xs:
        if test(x):
            n.incr()
    return n

// The list 0, 1, ..., n-1.
make iter_range(n: int) -> [int]:
    out: [int] = []
    i = 0
    while i < n:
        append(out, i)
        i.incr()
    return out
