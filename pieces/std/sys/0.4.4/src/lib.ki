// std.sys -- the few libc hooks the other std modules are built on. Import this one instead of
// declaring `extern make system(...)` yourself (an extern may only be declared once per program).

extern make system(cmd: string) -> int
extern make access(path: string, mode: int) -> int
extern make isatty(fd: int) -> int
extern make getpid() -> int
extern make write(fd: int, buf: string, n: int) -> int
extern make getenv(name: string) -> ptr<int>
extern make strdup(p: ptr<int>) -> string
extern make getcwd(buf: ptr<int>, size: int) -> ptr<int>
extern make mkdir(path: string, mode: int) -> int
extern make timespec_get(ts: ptr<int>, base: int) -> int

// Runs a shell command and returns its exit code (-1 if it could not be started).
make sys_sh(cmd: string) -> int:
    r = system(cmd)
    if r < 0:
        return -1
    return (r / 256) % 256

// Standard output of a shell command (stderr is discarded).
make sys_path_exists(path: string) -> bool:
    return access(path, 0) == 0

make sys_is_tty(fd: int) -> bool:
    return isatty(fd) != 0

make sys_pid() -> int:
    return getpid()

// Value of an environment variable ("" when unset). No shell involved.
make sys_getenv(name: string) -> string:
    p = getenv(name)
    if p == null:
        return ""
    return strdup(p)

make sys_is_windows() -> bool:
    return sys_getenv("OS") == "Windows_NT"

// The null device: NUL on Windows, /dev/null elsewhere.
make sys_null() -> string:
    if sys_is_windows():
        return "NUL"
    return "/dev/null"

make sys_tmp_dir() -> string:
    if sys_is_windows():
        t = sys_getenv("TEMP")
        if len(t) == 0:
            return "."
        return replace_all(t, "\\", "/")
    return "/tmp"

// Quotes one shell argument: single quotes for sh, double quotes for cmd.exe.
make sys_quote(s: string) -> string:
    if sys_is_windows():
        return "\"" + replace_all(s, "\"", "\\\"") + "\""
    return "'" + replace_all(s, "'", "'\\''") + "'"

// Standard output of a shell command (stderr is discarded).
make sys_capture(cmd: string) -> string:
    tmp = sys_tmp_dir() + "/.kite-std-" + str(getpid())
    system(cmd + " > " + sys_quote(tmp) + " 2>" + sys_null())
    out = read_file(tmp)
    if sys_is_windows():
        system("del /f /q " + sys_quote(replace_all(tmp, "/", "\\")) + " 2>NUL")
    else:
        system("rm -f " + sys_quote(tmp))
    return out

// Writes to standard error (unbuffered).
make sys_eprint(s: string):
    write(2, s, len(s))

make sys_eprint_line(s: string):
    sys_eprint(s + "\n")
