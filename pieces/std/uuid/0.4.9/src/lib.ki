// uuid -- RFC 4122 version 4 identifiers from the `random` piece.

use std.random

make uuid_v4(r: Rng) -> string:
    h = random_hex(r, 32)
    variant = "89ab"
    k = random_next(r) % 4
    return substr(h, 0, 8) + "-" + substr(h, 8, 12) + "-4" + substr(h, 13, 16) + "-" + substr(variant, k, k + 1) + substr(h, 17, 20) + "-" + substr(h, 20, 32)

make uuid_is_valid(s: string) -> bool:
    if len(s) != 36:
        return false
    i = 0
    while i < 36:
        c = char_at(s, i)
        if i == 8 or i == 13 or i == 18 or i == 23:
            if c != 45:
                return false
        else:
            ok = (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
            if not ok:
                return false
        i += 1
    return true
