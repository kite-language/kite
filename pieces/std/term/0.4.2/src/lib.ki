// std.term -- colours and terminal queries. Colours are only emitted when stdout is a terminal.

use std.sys

make term_is_tty() -> bool:
    return sys_is_tty(1)

// The ESC byte, built at run time (so the seed compiler's lexer, which has no `\x1b` escape, can compile this too).
make term_esc() -> string:
    return chr_byte(27)

// `s` wrapped in the SGR sequence `code` when `enabled`, else unchanged.
make term_paint_if(code: string, s: string, enabled: bool) -> string:
    if not enabled:
        return s
    e = term_esc()
    return e + "[" + code + "m" + s + e + "[0m"

make term_is_tty_fd(fd: int) -> bool:
    return sys_is_tty(fd)

make term_paint(code: string, s: string) -> string:
    return term_paint_if(code, s, term_is_tty())

make term_bold(s: string) -> string:
    return term_paint("1", s)

make term_dim(s: string) -> string:
    return term_paint("2", s)

make term_red(s: string) -> string:
    return term_paint("31", s)

make term_green(s: string) -> string:
    return term_paint("32", s)

make term_yellow(s: string) -> string:
    return term_paint("33", s)

make term_blue(s: string) -> string:
    return term_paint("34", s)

make term_cyan(s: string) -> string:
    return term_paint("36", s)

make term_clear() -> int:
    if term_is_tty():
        print(term_esc() + "[2J" + term_esc() + "[H")
    return 0

// Number of columns (80 when unknown).
make term_width() -> int:
    w = to_int(trim(sys_capture("tput cols")))
    if w <= 0:
        return 80
    return w
