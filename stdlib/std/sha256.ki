// std.sha256 -- SHA-256 of a string (bytes), as 64 lowercase hex characters.

make sha_rotr(x: int, n: int) -> int:
    return ((x >> n) | (x << (32 - n))) & 4294967295

make sha_k() -> [int]:
    return [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]

make sha_hex8(x: int) -> string:
    digits = "0123456789abcdef"
    out = ""
    i = 7
    while i >= 0:
        d = (x >> (i * 4)) & 15
        out = out + substr(digits, d, d + 1)
        i -= 1
    return out

make sha256_hex(text: string) -> string:
    mask = 4294967295
    k = sha_k()
    // padded message as bytes
    msg: [int] = []
    i = 0
    while i < len(text):
        append(msg, char_at(text, i))
        i += 1
    bitlen = len(text) * 8
    append(msg, 128)
    while len(msg) % 64 != 56:
        append(msg, 0)
    j = 7
    while j >= 0:
        append(msg, (bitlen >> (j * 8)) & 255)
        j -= 1
    h0 = 1779033703
    h1 = 3144134277
    h2 = 1013904242
    h3 = 2773480762
    h4 = 1359893119
    h5 = 2600822924
    h6 = 528734635
    h7 = 1541459225
    w: [int] = []
    t = 0
    while t < 64:
        append(w, 0)
        t += 1
    base = 0
    while base < len(msg):
        t = 0
        while t < 16:
            o = base + t * 4
            w[t] = (msg[o] << 24) | (msg[o + 1] << 16) | (msg[o + 2] << 8) | msg[o + 3]
            t += 1
        while t < 64:
            x15 = w[t - 15]
            x2 = w[t - 2]
            s0 = sha_rotr(x15, 7) ^ sha_rotr(x15, 18) ^ (x15 >> 3)
            s1 = sha_rotr(x2, 17) ^ sha_rotr(x2, 19) ^ (x2 >> 10)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & mask
            t += 1
        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        f = h5
        g = h6
        h = h7
        t = 0
        while t < 64:
            big1 = sha_rotr(e, 6) ^ sha_rotr(e, 11) ^ sha_rotr(e, 25)
            ch = (e & f) ^ ((e ^ mask) & g)
            temp1 = (h + big1 + ch + k[t] + w[t]) & mask
            big0 = sha_rotr(a, 2) ^ sha_rotr(a, 13) ^ sha_rotr(a, 22)
            maj = (a & b) ^ (a & c) ^ (b & c)
            temp2 = (big0 + maj) & mask
            h = g
            g = f
            f = e
            e = (d + temp1) & mask
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & mask
            t += 1
        h0 = (h0 + a) & mask
        h1 = (h1 + b) & mask
        h2 = (h2 + c) & mask
        h3 = (h3 + d) & mask
        h4 = (h4 + e) & mask
        h5 = (h5 + f) & mask
        h6 = (h6 + g) & mask
        h7 = (h7 + h) & mask
        base += 64
    return sha_hex8(h0) + sha_hex8(h1) + sha_hex8(h2) + sha_hex8(h3) + sha_hex8(h4) + sha_hex8(h5) + sha_hex8(h6) + sha_hex8(h7)
