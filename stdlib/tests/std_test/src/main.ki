use std.test
use std.path
use std.fmt
use std.semver
use std.sha256
use std.toml
use std.json
use std.fs
use std.process
use std.args
use std.time
use std.term
use std.git

make main():
    t = test_new("std")
    test_eq_str(t, "join", path_join("a", "b"), "a/b")
    test_eq_str(t, "norm", path_norm("/a/./b/../c//d"), "/a/c/d")
    test_eq_str(t, "ext", path_extension("x/y.tar.gz"), "gz")
    test_eq_str(t, "stem", path_stem("x/y.tar.gz"), "y.tar")
    test_eq_str(t, "parent", path_parent("/a/b/c"), "/a/b")
    test_eq_str(t, "pad", fmt_pad_left("7", 3), "  7")
    test_eq_str(t, "hex", fmt_hex(255), "ff")
    test_eq_str(t, "thousands", fmt_thousands(1234567), "1,234,567")
    test_eq_str(t, "milli", fmt_milli(1500), "1.500")
    test_eq_int(t, "cmp", semver_compare("1.2.3", "1.10.0"), -1)
    test_eq_int(t, "cmp pre", semver_compare("1.0.0-alpha", "1.0.0"), -1)
    test_true(t, "caret", semver_satisfies("1.4.2", "^1.2"))
    test_false(t, "caret2", semver_satisfies("2.0.0", "^1.2"))
    test_true(t, "tilde", semver_satisfies("1.2.9", "~1.2.3"))
    test_eq_str(t, "sha empty", sha256_hex(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    test_eq_str(t, "sha abc", sha256_hex("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    test_eq_str(t, "sha long", sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    cfg = "name = \"x\"\n[build]\nopt_level = 2\n"
    test_eq_str(t, "toml str", toml_get(cfg, "", "name", ""), "x")
    test_eq_int(t, "toml int", toml_get_int(cfg, "build", "opt_level", 0), 2)
    js = "{\"a\": {\"b\": [1, 2, {\"c\": \"hi\\n\"}]}, \"n\": 42, \"ok\": true}"
    test_eq_str(t, "json str", json_get(js, "a.b.2.c"), "hi\n")
    test_eq_str(t, "json num", json_get(js, "n"), "42")
    test_eq_str(t, "json bool", json_get(js, "ok"), "true")
    test_eq_int(t, "json arr", len(json_array(json_get_raw(js, "a.b"))), 3)
    test_eq_str(t, "json quote", json_quote("a\"b"), "\"a\\\"b\"")
    d = fs_temp_dir("stdtest")
    test_true(t, "tmp dir", fs_is_dir(d))
    test_true(t, "write", fs_write(path_join(d, "f.txt"), "hello"))
    test_true(t, "append", fs_append(path_join(d, "f.txt"), " world"))
    test_eq_str(t, "read", fs_read(path_join(d, "f.txt")), "hello world")
    test_eq_int(t, "list", len(fs_list(d)), 1)
    fs_remove_all(d)
    test_false(t, "removed", fs_exists(d))
    test_eq_int(t, "run", process_run("exit 3"), 3)
    test_eq_str(t, "output", trim(process_output("echo hi")), "hi")
    test_true(t, "which", process_which("sh"))
    a = args_from(["--out", "x", "file", "--n=5", "-v"])
    test_eq_str(t, "args value", args_value(a, "--out", ""), "x")
    test_eq_str(t, "args eq", args_value(a, "--n", ""), "5")
    test_true(t, "args flag", args_has_flag(a, "-v"))
    test_eq_int(t, "args pos", len(args_positional(a, ["--out"])), 1)
    t0 = time_now_ns()
    test_true(t, "time", t0 > 0)
    test_eq_str(t, "term", term_bold("x"), "x")
    test_true(t, "git", git_available() or true)
    exit(test_finish(t))
