make prelude_map_tpl() -> string:
    s = ""
    s = s + "// string -> @V@ hash map (open addressing, insertion-ordered `keys`).\n"
    s = s + "class @N@:\n"
    s = s + "    keys: [string]\n"
    s = s + "    vals: [@V@]\n"
    s = s + "    slots: [int]\n"
    s = s + "    count: int\n"
    s = s + "\n"
    s = s + "    make init(self):\n"
    s = s + "        self.count = 0\n"
    s = s + "        self.rebuild(8)\n"
    s = s + "\n"
    s = s + "    make rebuild(self, cap: int):\n"
    s = s + "        ns: [int] = []\n"
    s = s + "        i = 0\n"
    s = s + "        while i < cap:\n"
    s = s + "            append(ns, 0)\n"
    s = s + "            i += 1\n"
    s = s + "        self.slots = ns\n"
    s = s + "        j = 0\n"
    s = s + "        while j < len(self.keys):\n"
    s = s + "            self.place(self.keys[j], j)\n"
    s = s + "            j += 1\n"
    s = s + "\n"
    s = s + "    make hash(self, k: string) -> int:\n"
    s = s + "        h = 5381\n"
    s = s + "        i = 0\n"
    s = s + "        while i < len(k):\n"
    s = s + "            h = (h * 33 + char_at(k, i)) & 1073741823\n"
    s = s + "            i += 1\n"
    s = s + "        return h\n"
    s = s + "\n"
    s = s + "    make place(self, k: string, idx: int):\n"
    s = s + "        mask = len(self.slots) - 1\n"
    s = s + "        p = self.hash(k) & mask\n"
    s = s + "        while self.slots[p] != 0:\n"
    s = s + "            p = (p + 1) & mask\n"
    s = s + "        self.slots[p] = idx + 1\n"
    s = s + "\n"
    s = s + "    make slot_of(self, k: string) -> int:\n"
    s = s + "        mask = len(self.slots) - 1\n"
    s = s + "        p = self.hash(k) & mask\n"
    s = s + "        while self.slots[p] != 0:\n"
    s = s + "            if self.keys[self.slots[p] - 1] == k:\n"
    s = s + "                return self.slots[p] - 1\n"
    s = s + "            p = (p + 1) & mask\n"
    s = s + "        return -1\n"
    s = s + "\n"
    s = s + "    make has(self, k: string) -> bool:\n"
    s = s + "        return self.slot_of(k) >= 0\n"
    s = s + "\n"
    s = s + "    make size(self) -> int:\n"
    s = s + "        return self.count\n"
    s = s + "\n"
    s = s + "    make get(self, k: string) -> @V@:\n"
    s = s + "        i = self.slot_of(k)\n"
    s = s + "        if i < 0:\n"
    s = s + "            return @Z@\n"
    s = s + "        return self.vals[i]\n"
    s = s + "\n"
    s = s + "    make set(self, k: string, v: @V@):\n"
    s = s + "        i = self.slot_of(k)\n"
    s = s + "        if i >= 0:\n"
    s = s + "            self.vals[i] = v\n"
    s = s + "            return\n"
    s = s + "        append(self.keys, k)\n"
    s = s + "        append(self.vals, v)\n"
    s = s + "        self.count += 1\n"
    s = s + "        if self.count * 2 >= len(self.slots):\n"
    s = s + "            self.rebuild(len(self.slots) * 2)\n"
    s = s + "        else:\n"
    s = s + "            self.place(k, self.count - 1)\n"
    return s

make prelude_num() -> string:
    s = ""
    s = s + "// Kite prelude: the `num` type, a number that is either an int or a float.\n"
    s = s + "// Loaded only into programs that mention the type `num`. The compiler turns operators on `num` values into calls of the\n"
    s = s + "// `num__*` functions below, and converts an `int` or a `float` to `num` where a `num` is expected.\n"
    s = s + "type num:\n"
    s = s + "    is_float: bool\n"
    s = s + "    i: int\n"
    s = s + "    f: float\n"
    s = s + "\n"
    s = s + "make num__from_int(x: int) -> num:\n"
    s = s + "    n = num()\n"
    s = s + "    n.i = x\n"
    s = s + "    return n\n"
    s = s + "\n"
    s = s + "make num__from_float(x: float) -> num:\n"
    s = s + "    n = num()\n"
    s = s + "    n.is_float = true\n"
    s = s + "    n.f = x\n"
    s = s + "    return n\n"
    s = s + "\n"
    s = s + "// The value as a float (an int is converted).\n"
    s = s + "make as_float(a: num) -> float:\n"
    s = s + "    if a.is_float:\n"
    s = s + "        return a.f\n"
    s = s + "    return float_of(a.i)\n"
    s = s + "\n"
    s = s + "// The value as an int (a float is truncated toward zero).\n"
    s = s + "make as_int(a: num) -> int:\n"
    s = s + "    if a.is_float:\n"
    s = s + "        return int_of(a.f)\n"
    s = s + "    return a.i\n"
    s = s + "\n"
    s = s + "// True when the value currently holds a float.\n"
    s = s + "make is_float(a: num) -> bool:\n"
    s = s + "    return a.is_float\n"
    s = s + "\n"
    s = s + "make num__add(a: num, b: num) -> num:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        return num__from_float(as_float(a) + as_float(b))\n"
    s = s + "    return num__from_int(a.i + b.i)\n"
    s = s + "\n"
    s = s + "make num__sub(a: num, b: num) -> num:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        return num__from_float(as_float(a) - as_float(b))\n"
    s = s + "    return num__from_int(a.i - b.i)\n"
    s = s + "\n"
    s = s + "make num__mul(a: num, b: num) -> num:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        return num__from_float(as_float(a) * as_float(b))\n"
    s = s + "    return num__from_int(a.i * b.i)\n"
    s = s + "\n"
    s = s + "// int / int stays an integer division, anything with a float is a float division.\n"
    s = s + "make num__div(a: num, b: num) -> num:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        return num__from_float(as_float(a) / as_float(b))\n"
    s = s + "    return num__from_int(a.i / b.i)\n"
    s = s + "\n"
    s = s + "// Remainder; with floats the sign follows the dividend, like C's fmod.\n"
    s = s + "make num__mod(a: num, b: num) -> num:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        x = as_float(a)\n"
    s = s + "        y = as_float(b)\n"
    s = s + "        return num__from_float(x - y * float_of(int_of(x / y)))\n"
    s = s + "    return num__from_int(a.i % b.i)\n"
    s = s + "\n"
    s = s + "make num__neg(a: num) -> num:\n"
    s = s + "    if a.is_float:\n"
    s = s + "        return num__from_float(0.0 - a.f)\n"
    s = s + "    return num__from_int(0 - a.i)\n"
    s = s + "\n"
    s = s + "make num__lt(a: num, b: num) -> bool:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        return as_float(a) < as_float(b)\n"
    s = s + "    return a.i < b.i\n"
    s = s + "\n"
    s = s + "make num__gt(a: num, b: num) -> bool:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        return as_float(a) > as_float(b)\n"
    s = s + "    return a.i > b.i\n"
    s = s + "\n"
    s = s + "make num__le(a: num, b: num) -> bool:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        return as_float(a) <= as_float(b)\n"
    s = s + "    return a.i <= b.i\n"
    s = s + "\n"
    s = s + "make num__ge(a: num, b: num) -> bool:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        return as_float(a) >= as_float(b)\n"
    s = s + "    return a.i >= b.i\n"
    s = s + "\n"
    s = s + "// 1 and 1.0 are equal.\n"
    s = s + "make num__eq(a: num, b: num) -> bool:\n"
    s = s + "    if a.is_float or b.is_float:\n"
    s = s + "        return as_float(a) == as_float(b)\n"
    s = s + "    return a.i == b.i\n"
    s = s + "\n"
    s = s + "make num__ne(a: num, b: num) -> bool:\n"
    s = s + "    return not num__eq(a, b)\n"
    s = s + "\n"
    s = s + "// \"7\" for an int, \"2.5\" or \"3.0\" for a float.\n"
    s = s + "make num__str(a: num) -> string:\n"
    s = s + "    if not a.is_float:\n"
    s = s + "        return str(a.i)\n"
    s = s + "    s = str(a.f)\n"
    s = s + "    if find(s, \".\") < 0 and find(s, \"e\") < 0 and find(s, \"n\") < 0 and find(s, \"i\") < 0:\n"
    s = s + "        return s + \".0\"\n"
    s = s + "    return s\n"
    return s

