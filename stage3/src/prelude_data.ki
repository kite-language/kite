    s = s + "    return substr(table, k, k + 1)\n"
    s = s + "\n"
    s = s + "make to_int(s: string) -> int:\n"
    s = s + "    t = trim(s)\n"
    s = s + "    neg = false\n"
    s = s + "    i = 0\n"
    s = s + "    if len(t) > 0 and char_at(t, 0) == 45:\n"
