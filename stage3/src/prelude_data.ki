    s = s + "    return b\n"
    s = s + "\n"
    s = s + "make abs(a: int) -> int:\n"
    s = s + "    if a < 0:\n"
    s = s + "        return 0 - a\n"
    s = s + "    return a\n"
    s = s + "\n"
    s = s + "// Prints `panic: msg` and stops the program with exit code 101.\n"
    s = s + "make panic(msg: string):\n"
    s = s + "    print(\"panic: \" + msg)\n"
    s = s + "    exit(101)\n"
    s = s + "\n"
    s = s + "make assert(cond: bool, msg: string):\n"
