make prelude_core() -> string:
    s = ""
    s = s + "// Kite prelude: string helpers written in Kite itself.\n"
    s = s + "// Only the functions a program actually references are compiled in.\n"
    s = s + "\n"
    s = s + "make starts_with(s: string, p: string) -> bool:\n"
    s = s + "    if len(p) > len(s):\n"
    s = s + "        return false\n"
    s = s + "    return substr(s, 0, len(p)) == p\n"
    s = s + "\n"
