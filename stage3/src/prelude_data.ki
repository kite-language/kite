    s = s + "        return \"\\\\\"\n"
    s = s + "    table = \" !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~\"\n"
    s = s + "    if c < 32 or c > 126:\n"
