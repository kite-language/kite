    s = s + "\n"
    s = s + "// Merges neighbours pairwise (O(n log n) copying instead of O(n^2) for long lists).\n"
    s = s + "make join(xs: [string], sep: string) -> string:\n"
    s = s + "    if len(xs) == 0:\n"
    s = s + "        return \"\"\n"
    s = s + "    cur = xs\n"
    s = s + "    while len(cur) > 1:\n"
    s = s + "        nxt: [string] = []\n"
    s = s + "        i = 0\n"
    s = s + "        while i + 1 < len(cur):\n"
