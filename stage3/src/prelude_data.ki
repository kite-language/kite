    s = s + "            append(nxt, cur[i])\n"
    s = s + "        cur = nxt\n"
    s = s + "    return cur[0]\n"
    s = s + "\n"
    s = s + "make replace_all(s: string, a: string, b: string) -> string:\n"
    s = s + "    if len(a) == 0:\n"
    s = s + "        return s\n"
    s = s + "    return join(split(s, a), b)\n"
