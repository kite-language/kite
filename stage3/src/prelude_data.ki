    s = s + "    return a\n"
    return s

make prelude_map_tpl() -> string:
    s = ""
    s = s + "// string -> @V@ hash map (open addressing, insertion-ordered `keys`).\n"
    s = s + "class @N@:\n"
    s = s + "    keys: [string]\n"
    s = s + "    vals: [@V@]\n"
    s = s + "    slots: [int]\n"
    s = s + "    count: int\n"
    s = s + "\n"
    s = s + "    make init(self):\n"
    s = s + "        self.count = 0\n"
    s = s + "        self.rebuild(8)\n"
    s = s + "\n"
    s = s + "    make rebuild(self, cap: int):\n"
    s = s + "        ns: [int] = []\n"
    s = s + "        i = 0\n"
    s = s + "        while i < cap:\n"
    s = s + "            append(ns, 0)\n"
    s = s + "            i += 1\n"
    s = s + "        self.slots = ns\n"
    s = s + "        j = 0\n"
    s = s + "        while j < len(self.keys):\n"
    s = s + "            self.place(self.keys[j], j)\n"
    s = s + "            j += 1\n"
    s = s + "\n"
    s = s + "    make hash(self, k: string) -> int:\n"
    s = s + "        h = 5381\n"
    s = s + "        i = 0\n"
    s = s + "        while i < len(k):\n"
    s = s + "            h = (h * 33 + char_at(k, i)) & 1073741823\n"
    s = s + "            i += 1\n"
    s = s + "        return h\n"
    s = s + "\n"
    s = s + "    make place(self, k: string, idx: int):\n"
    s = s + "        mask = len(self.slots) - 1\n"
    s = s + "        p = self.hash(k) & mask\n"
    s = s + "        while self.slots[p] != 0:\n"
    s = s + "            p = (p + 1) & mask\n"
    s = s + "        self.slots[p] = idx + 1\n"
    s = s + "\n"
    s = s + "    make slot_of(self, k: string) -> int:\n"
    s = s + "        mask = len(self.slots) - 1\n"
    s = s + "        p = self.hash(k) & mask\n"
    s = s + "        while self.slots[p] != 0:\n"
    s = s + "            if self.keys[self.slots[p] - 1] == k:\n"
    s = s + "                return self.slots[p] - 1\n"
    s = s + "            p = (p + 1) & mask\n"
    s = s + "        return -1\n"
    s = s + "\n"
    s = s + "    make has(self, k: string) -> bool:\n"
    s = s + "        return self.slot_of(k) >= 0\n"
    s = s + "\n"
    s = s + "    make size(self) -> int:\n"
    s = s + "        return self.count\n"
    s = s + "\n"
    s = s + "    make get(self, k: string) -> @V@:\n"
    s = s + "        i = self.slot_of(k)\n"
    s = s + "        if i < 0:\n"
    s = s + "            return @Z@\n"
    s = s + "        return self.vals[i]\n"
    s = s + "\n"
    s = s + "    make set(self, k: string, v: @V@):\n"
    s = s + "        i = self.slot_of(k)\n"
    s = s + "        if i >= 0:\n"
    s = s + "            self.vals[i] = v\n"
    s = s + "            return\n"
    s = s + "        append(self.keys, k)\n"
    s = s + "        append(self.vals, v)\n"
    s = s + "        self.count += 1\n"
    s = s + "        if self.count * 2 >= len(self.slots):\n"
    s = s + "            self.rebuild(len(self.slots) * 2)\n"
    s = s + "        else:\n"
    s = s + "            self.place(k, self.count - 1)\n"
    return s

