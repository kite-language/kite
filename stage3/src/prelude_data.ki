    s = s + "    return s\n"
    s = s + "\n"
    s = s + "make chr(c: int) -> string:\n"
    s = s + "    if c == 10:\n"
    s = s + "        return \"\\n\"\n"
    s = s + "    if c == 9:\n"
    s = s + "        return \"\\t\"\n"
    s = s + "    if c == 13:\n"
    s = s + "        return chr_byte(13)\n"
    s = s + "    if c == 34:\n"
    s = s + "        return \"\\\"\"\n"
    s = s + "    if c == 92:\n"
    s = s + "        return \"\\\\\"\n"
    s = s + "    table = \" !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~\"\n"
    s = s + "    if c < 32 or c > 126:\n"
    s = s + "        return \"?\"\n"
    s = s + "    k = c - 32\n"
    s = s + "    if c > 34:\n"
    s = s + "        k = c - 33\n"
    s = s + "    if c > 92:\n"
    s = s + "        k = c - 34\n"
    s = s + "    return substr(table, k, k + 1)\n"
    s = s + "\n"
    s = s + "make to_int(s: string) -> int:\n"
    s = s + "    t = trim(s)\n"
    s = s + "    neg = false\n"
    s = s + "    i = 0\n"
    s = s + "    if len(t) > 0 and char_at(t, 0) == 45:\n"
    s = s + "        neg = true\n"
    s = s + "        i = 1\n"
    s = s + "    r = 0\n"
    s = s + "    while i < len(t):\n"
    s = s + "        c = char_at(t, i)\n"
    s = s + "        if c < 48 or c > 57:\n"
    s = s + "            break\n"
    s = s + "        r = r * 10 + (c - 48)\n"
    s = s + "        i += 1\n"
    s = s + "    if neg:\n"
    s = s + "        return 0 - r\n"
    s = s + "    return r\n"
    s = s + "\n"
    s = s + "make is_alpha(c: int) -> bool:\n"
    s = s + "    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95\n"
    s = s + "\n"
    s = s + "make is_digit(c: int) -> bool:\n"
    s = s + "    return c >= 48 and c <= 57\n"
    s = s + "\n"
    s = s + "make is_alnum(c: int) -> bool:\n"
    s = s + "    return is_alpha(c) or is_digit(c)\n"
    s = s + "\n"
    s = s + "make min(a: int, b: int) -> int:\n"
    s = s + "    if a < b:\n"
    s = s + "        return a\n"
    s = s + "    return b\n"
    s = s + "\n"
    s = s + "make max(a: int, b: int) -> int:\n"
    s = s + "    if a > b:\n"
