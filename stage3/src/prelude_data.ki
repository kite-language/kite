    s = s + "        r = r * 10 + (c - 48)\n"
    s = s + "        i += 1\n"
    s = s + "    if neg:\n"
    s = s + "        return 0 - r\n"
    s = s + "    return r\n"
    s = s + "\n"
    s = s + "make is_alpha(c: int) -> bool:\n"
    s = s + "    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95\n"
