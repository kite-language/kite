// Build targets (like `rustup target add`): hosted triples, and bare-metal targets for writing an
// operating system. A bare-metal target must be installed first (`kite target add <name>`); the
// installation writes target.toml and a linker script under ~/.kite/targets/<name>/.

use sysx
use project

type TargetSpec:
    name: string
    triple: string
    kind: string
    arch: string
    base: string
    entry: string
    known: bool

make target_spec(name: string) -> TargetSpec:
    t = TargetSpec()
    t.name = name
    t.kind = "hosted"
    t.known = true
    if name == "x86_64-unknown-none":
        t.triple = "x86_64-unknown-none-elf"
        t.kind = "bare"
        t.arch = "x86-64"
        t.base = "0x100000"
        t.entry = "_start"
    orif name == "aarch64-unknown-none":
        t.triple = "aarch64-unknown-none-elf"
        t.kind = "bare"
        t.arch = "aarch64"
        t.base = "0x40080000"
        t.entry = "_start"
    orif name == "riscv64-unknown-none":
        t.triple = "riscv64-unknown-none-elf"
        t.kind = "bare"
        t.arch = "riscv64"
        t.base = "0x80000000"
        t.entry = "_start"
    orif name == "x86_64-unknown-linux-gnu":
        t.triple = name
        t.arch = "x86-64"
    orif name == "aarch64-unknown-linux-gnu":
        t.triple = name
        t.arch = "aarch64"
    orif name == "x86_64-pc-windows-msvc":
        t.triple = name
        t.arch = "x86-64"
    orif name == "aarch64-apple-darwin":
        t.triple = name
        t.arch = "aarch64"
    orif name == "x86_64-apple-darwin":
        t.triple = name
        t.arch = "x86-64"
    else:
        // any other triple is passed to clang as is
        t.triple = name
        t.known = false
    return t

make known_targets() -> [string]:
    return ["x86_64-unknown-none", "aarch64-unknown-none", "riscv64-unknown-none", "x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "x86_64-pc-windows-msvc", "aarch64-apple-darwin", "x86_64-apple-darwin"]

make kite_home() -> string:
    env = trim(capture("printf %s \"$KITE_HOME\""))
    if len(env) > 0:
        return env
    return path_join(trim(capture("printf %s \"$HOME\"")), ".kite")

make target_dir(name: string) -> string:
    return path_join(path_join(kite_home(), "targets"), name)

make target_installed(name: string) -> bool:
    return file_exists(path_join(target_dir(name), "target.toml"))

make linker_script(t: TargetSpec) -> string:
    out = "/* Linker script generated by `kite target add " + t.name + "` */\n"
    out = out + "ENTRY(" + t.entry + ")\n\nSECTIONS\n{\n    . = " + t.base + ";\n"
    out = out + "    .text   : { *(.text._start) *(.text .text.*) }\n"
    out = out + "    .rodata : { *(.rodata .rodata.*) }\n"
    out = out + "    .data   : { *(.data .data.*) }\n"
    out = out + "    .bss    : { *(COMMON) *(.bss .bss.*) }\n"
    out = out + "    /DISCARD/ : { *(.comment) *(.eh_frame) *(.note*) }\n}\n"
    return out

// Which linker is available (lld), "" if none.
make find_linker() -> string:
    if sh("command -v ld.lld > /dev/null 2>&1") == 0:
        return "ld.lld"
    if sh("command -v lld > /dev/null 2>&1") == 0:
        return "lld -flavor gnu"
    return ""

make clang_supports(arch: string) -> bool:
    out = capture("clang --print-targets")
    return contains_str(out, arch)

make cmd_target_add(name: string):
    t = target_spec(name)
    if not t.known:
        die("unknown target `" + name + "` (see `kite target list`)")
    if not clang_supports(t.arch):
        die("this clang cannot generate code for `" + t.arch + "`; install an LLVM build with that backend and retry")
    if t.kind == "bare" and len(find_linker()) == 0:
        die("target `" + name + "` needs the LLD linker (`ld.lld`): install the `lld` package and retry")
    dir = target_dir(name)
    mkdir_all(dir)
    spec = "[target]\nname = " + quote_toml(t.name) + "\ntriple = " + quote_toml(t.triple) + "\nkind = " + quote_toml(t.kind) + "\n"
    if t.kind == "bare":
        spec = spec + "entry = " + quote_toml(t.entry) + "\nlinker_script = \"link.ld\"\n"
        write_file(path_join(dir, "link.ld"), linker_script(t))
    write_file(path_join(dir, "target.toml"), spec)
    status("Installed", "target `" + name + "` (" + t.triple + ", " + t.kind + ") in " + dir)
    if t.kind == "bare":
        print("       build with `kite build --target " + name + "`; define `make " + t.entry + "():` as the entry point")

make cmd_target_remove(name: string):
    if not target_installed(name):
        die("target `" + name + "` is not installed")
    remove_dir_all(target_dir(name))
    status("Removed", "target `" + name + "`")

make cmd_target_list():
    for n in known_targets():
        t = target_spec(n)
        mark = ""
        if t.kind == "bare":
            mark = "  (not installed)"
            if target_installed(n):
                mark = "  (installed)"
        print(n + "  [" + t.kind + "]" + mark)

make cmd_target_show(name: string):
    t = target_spec(name)
    print("name:   " + t.name)
    print("triple: " + t.triple)
    print("kind:   " + t.kind)
    if t.kind == "bare":
        print("entry:  " + t.entry)
        print("base:   " + t.base)
        if target_installed(name):
            print("linker script: " + path_join(target_dir(name), "link.ld"))
        else:
            print("not installed: run `kite target add " + name + "`")

// Links a freestanding object into an ELF image with the target's linker script.
make link_bare(obj: string, out_path: string, t: TargetSpec) -> bool:
    ld = find_linker()
    if len(ld) == 0:
        die("the LLD linker (`ld.lld`) is required to link `" + t.name + "`")
    script = path_join(target_dir(t.name), "link.ld")
    cmd = ld + " -T " + shell_quote(script) + " -nostdlib -static -o " + shell_quote(out_path) + " " + shell_quote(obj)
    return sh(cmd) == 0
