// Semantic analysis (port of src/sema.rs): name resolution, type inference and checking over the
// desugared AST. Types are textual (see types.ki); "" stands for `None` wherever Rust has an
// Option<TypeName>. On success the AST is the typed program (inferred return types are written
// back into the functions).

use diag
use ast
use types
use irdef
use std.sys

type SigT:
    params: [string]
    ret: string
    has_ret: bool

type StructT:
    names: [string]
    types: [string]

type EnumT:
    names: [string]

make op_symbol(op: string) -> string:
    if op == "Add":
        return "+"
    orif op == "Sub":
        return "-"
    orif op == "Mul":
        return "*"
    orif op == "Div":
        return "/"
    orif op == "Mod":
        return "%"
    orif op == "Eq":
        return "=="
    orif op == "NotEq":
        return "!="
    orif op == "Lt":
        return "<"
    orif op == "Gt":
        return ">"
    orif op == "LtEq":
        return "<="
    orif op == "GtEq":
        return ">="
    orif op == "And":
        return "and"
    orif op == "Or":
        return "or"
    orif op == "BitAnd":
        return "&"
    orif op == "BitOr":
        return "|"
    orif op == "BitXor":
        return "^"
    orif op == "Shl":
        return "<<"
    return ">>"

make is_scalar(t: string) -> bool:
    return ty_is_scalar_name(t) or ty_is_enum(t) or ty_is_ptr(t)

make is_first_class_value(t: string) -> bool:
    return is_scalar(t) or t == "()"

make is_returnable(t: string) -> bool:
    return is_first_class_value(t) or ty_is_list(t) or ty_is_tuple(t) or ty_is_dict(t) or ty_is_named(t)

make is_struct_ty(t: string) -> bool:
    return ty_is_named(t)

// ---- generic functions -------------------------------------------------------------------------------
make is_generic_fn(ast: Ast, f: int) -> bool:
    return contains_str(ast.nodes[ast.nodes[f].kids[2]].text, "generic:")

make is_word_char(c: int) -> bool:
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or c == 95 or (c >= 97 and c <= 122)

// Replaces the type parameters `tn` by `tv` in a type text such as `[T]` or `ptr<T>`.
make subst_type(text: string, tn: [string], tv: [string]) -> string:
    out = ""
    word = ""
    i = 0
    while i <= len(text):
        c = 0
        if i < len(text):
            c = char_at(text, i)
        if i < len(text) and is_word_char(c):
            word = word + chr(c)
        else:
            if len(word) > 0:
                k = index_of_str(tn, word)
                if k >= 0:
                    out = out + tv[k]
                else:
                    out = out + word
                word = ""
            if i < len(text):
                out = out + chr(c)
        i += 1
    return out

// A name for an instance: `first__int`, `first__Lstring` (for `[string]`).
make mangle_type(t: string) -> string:
    s = replace_all(t, "[", "L")
    s = replace_all(s, "]", "")
    s = replace_all(s, "<", "_")
    s = replace_all(s, ">", "")
    s = replace_all(s, "@", "")
    s = replace_all(s, "(", "T")
    s = replace_all(s, ")", "")
    s = replace_all(s, ",", "_")
    s = replace_all(s, " ", "")
    return s

// A struct field may be a scalar, a named type (struct/enum) or a list of those, nested to any depth.
make field_type_ok(t: string) -> bool:
    if is_scalar(t):
        return true
    if ty_is_list(t):
        return field_type_ok(ty_list_elem(t))
    return ty_is_named(t)

// ---- generic records (`type Box<T>:`) -------------------------------------------------------------------
make is_generic_struct(ast: Ast, st: int) -> bool:
    k = ast.nodes[st].kids
    return len(k) > 2 and k[2] >= 0 and contains_str(ast.nodes[k[2]].text, "generic:")

// Splits `int,[string],Pair<a,b>` at the commas that are not nested in `<>`, `[]` or `()`.
make split_top(text: string) -> [string]:
    out: [string] = []
    depth = 0
    cur = ""
    i = 0
    while i < len(text):
        c = char_at(text, i)
        if c == 60 or c == 91 or c == 40:
            depth += 1
        orif c == 62 or c == 93 or c == 41:
            depth -= 1
        if c == 44 and depth == 0:
            append(out, cur)
            cur = ""
        else:
            cur = cur + chr(c)
        i += 1
    append(out, cur)
    return out

// ---- function values (`fn(int, string) -> bool`) -----------------------------------------------------------
make ty_is_fn(t: string) -> bool:
    return starts_with(t, "fn(")

// Index of the `)` that closes the parameter list of the function type `t`.
make fn_close(t: string) -> int:
    depth = 0
    i = 2
    while i < len(t):
        c = char_at(t, i)
        if c == 40:
            depth += 1
        orif c == 41:
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return len(t) - 1

make ty_fn_params(t: string) -> [string]:
    inner = substr(t, 3, fn_close(t))
    if len(inner) == 0:
        out: [string] = []
        return out
    return split_top(inner)

make ty_fn_ret(t: string) -> string:
    return substr(t, fn_close(t) + 3, len(t))

// Function values pass and return scalars, strings and pointers (aggregates need another calling convention).
make fn_value_type_ok(t: string) -> bool:
    return t == "int" or t == "float" or t == "bool" or t == "string" or t == "()" or ty_is_ptr(t) or starts_with(t, "@") or ty_is_fn(t)

// The elements of `xs` from index `from_i` on.
make slice_from(xs: [string], from_i: int) -> [string]:
    out: [string] = []
    i = from_i
    while i < len(xs):
        append(out, xs[i])
        i += 1
    return out

class Sema:
    ast: Ast
    diags: Diags
    pre: Diags
    prog: int
    // tables
    sigs: [SigT]
    sig_idx: StrMap_int
    structs: [StructT]
    struct_idx: StrMap_int
    enums: [EnumT]
    enum_idx: StrMap_int
    org_idx: StrMap_int
    org_files: [string]
    org_srcs: [string]
    // scopes: parallel lists plus the start index of every open scope
    var_names: [string]
    var_types: [string]
    marks: [int]
    cur_fn: string
    cur_ret: string
    cur_has_ret: bool
    ret_blocked: bool
    loop_depth: int
    lambda_count: int
    structs_l: int
    gstruct_idx: StrMap_int
    gstruct_nodes: [int]
    ginst_names: [string]
    ginst_base: [string]
    ginst_args: [string]
    const_vars: [string]
    consts: StrMap_int
    // generic functions (instantiated per argument types)
    fns_l: int
    gen_idx: StrMap_int
    gen_nodes: [int]
    inst_idx: StrMap_int
    pending: [int]
    ub_names: [string]
    ub_vals: [string]

    make err(self, code: string, msg: string, span: Span):
        self.diags.add(code, msg, span)

    make perr(self, code: string, msg: string, span: Span):
        self.pre.add(code, msg, span)

    make tag_from(self, d: Diags, before: int, name: string):
        if not self.org_idx.has(name):
            return
        oi = self.org_idx.get(name) - 1
        i = before
        while i < len(d.items):
            if not d.items[i].has_file:
                d.items[i].file = self.org_files[oi]
                d.items[i].source = self.org_srcs[oi]
                d.items[i].has_file = true
            i += 1

    // ---- scopes ---------------------------------------------------------------------------
    make push_scope(self):
        append(self.marks, len(self.var_names))

    make pop_scope(self):
        m = pop(self.marks)
        while len(self.var_names) > m:
            pop(self.var_names)
            pop(self.var_types)

    make declare(self, name: string, t: string):
        append(self.var_names, name)
        append(self.var_types, t)

    make lookup(self, name: string) -> string:
        i = len(self.var_names) - 1
        while i >= 0:
            if self.var_names[i] == name:
                return self.var_types[i]
            i -= 1
        return ""

    // ---- table helpers ---------------------------------------------------------------------
    make struct_of(self, name: string) -> int:
        if self.struct_idx.has(name):
            return self.struct_idx.get(name) - 1
        return -1

    make has_struct(self, name: string) -> bool:
        return self.struct_idx.has(name)

    make field_ty(self, si: int, field: string) -> string:
        i = 0
        while i < len(self.structs[si].names):
            if self.structs[si].names[i] == field:
                return self.structs[si].types[i]
            i += 1
        return ""

    make is_subtype(self, sub: string, sup: string) -> bool:
        if not ty_is_named(sub) or not ty_is_named(sup):
            return false
        a = self.struct_of(sub)
        b = self.struct_of(sup)
        if a < 0 or b < 0:
            return false
        nb = len(self.structs[b].names)
        if nb == 0 or len(self.structs[a].names) < nb:
            return false
        i = 0
        while i < nb:
            if self.structs[a].names[i] != self.structs[b].names[i] or self.structs[a].types[i] != self.structs[b].types[i]:
                return false
            i += 1
        return true

    // ---- functions -------------------------------------------------------------------------
    make lock_return_type(self, t: string):
        if not self.cur_has_ret:
            self.cur_ret = t
            self.cur_has_ret = true
            si = self.sig_idx.get(self.cur_fn) - 1
            self.sigs[si].ret = t
            self.sigs[si].has_ret = true

    make check_function(self, f: int):
        fk = self.ast.nodes[f].kids
        fname = self.ast.nodes[f].text
        if contains_str(self.ast.nodes[fk[2]].text, "extern"):
            return
        self.push_scope()
        clear(self.const_vars)
        self.cur_fn = fname
        si = self.sig_idx.get(fname) - 1
        self.cur_has_ret = self.sigs[si].has_ret
        self.cur_ret = self.sigs[si].ret
        self.ret_blocked = false
        pl = self.ast.nodes[fk[0]].kids
        for p in pl:
            self.declare(self.ast.nodes[p].text, self.ast.nodes[self.ast.nodes[p].kids[0]].text)
        falls = self.check_block(fk[3])
        if not self.cur_has_ret:
            if self.ret_blocked:
                self.err("E0060", f"cannot infer the return type of `{fname}` -- no `return` statement resolves without depending on its own return type; add an explicit `-> Type`", self.ast.nodes[f].span)
            self.lock_return_type("()")
        rt = self.cur_ret
        if falls and rt != "()":
            self.err("E0030", f"function `{fname}` is declared to return `{ty_disp(rt)}` but does not return a value on all paths", self.ast.nodes[f].span)
        self.pop_scope()

    make check_block(self, b: int) -> bool:
        self.push_scope()
        falls = true
        sl = self.ast.nodes[b].kids
        for s in sl:
            falls = self.check_stmt(s)
        self.pop_scope()
        return falls

    make expect_bool(self, t: string, span: Span):
        if t != "bool":
            self.err("E0024", f"expected `bool` condition, found `{ty_disp(t)}`", span)

    make is_deref(self, e: int) -> bool:
        return self.ast.nodes[e].kind == "Unary" and self.ast.nodes[e].text == "Deref"

    make check_stmt(self, s: int) -> bool:
        n = self.ast.nodes[s]
        k = n.kind
        kids = n.kids
        span = n.span
        if k == "Unpack":
            self.err("E0101", "internal: unpacking was not desugared", span)
            return false
        if k == "Match":
            self.err("E0107", "internal: `match` was not desugared", span)
            return false
        if k == "Assign":
            ann = ""
            if kids[1] >= 0:
                ann = self.ast.nodes[kids[1]].text
            root = self.lvalue_root(kids[0])
            if n.text == "const":
                self.check_assign(kids[0], ann, kids[2], span)
                append(self.const_vars, root)
                return true
            if len(root) > 0:
                if index_of_str(self.const_vars, root) >= 0 or (self.ast.nodes[kids[0]].kind == "LIdent" and len(self.lookup(root)) == 0 and self.consts.has(root)):
                    self.err("E0124", f"cannot assign to the constant `{root}`", span)
                    return true
            self.check_assign(kids[0], ann, kids[2], span)
            return true
        if k == "ExprStmt":
            self.check_expr(kids[0])
            return true
        if k == "Return":
            self.check_return(kids[0], span)
            return false
        if k == "Break":
            if self.loop_depth == 0:
                self.err("E0040", "`break` outside of a loop", span)
            return false
        if k == "Continue":
            if self.loop_depth == 0:
                self.err("E0041", "`continue` outside of a loop", span)
            return false
        if k == "If":
            cty = self.check_expr(kids[0])
            self.expect_bool(cty, self.ast.nodes[kids[0]].span)
            any_falls = self.check_block(kids[1])
            ol = self.ast.nodes[kids[2]].kids
            for o in ol:
                ok = self.ast.nodes[o].kids
                oty = self.check_expr(ok[0])
                self.expect_bool(oty, self.ast.nodes[ok[0]].span)
                if self.check_block(ok[1]):
                    any_falls = true
            if kids[3] >= 0:
                if self.check_block(kids[3]):
                    any_falls = true
            else:
                any_falls = true
            return any_falls
        if k == "Until" or k == "While":
            cty2 = self.check_expr(kids[0])
            self.expect_bool(cty2, self.ast.nodes[kids[0]].span)
            self.loop_depth += 1
            self.check_block(kids[1])
            self.loop_depth -= 1
            return true
        if k == "Infinit":
            self.loop_depth += 1
            self.check_block(kids[0])
            self.loop_depth -= 1
            return true
        if k == "ForRange":
            sty = self.check_expr(kids[0])
            ety = self.check_expr(kids[1])
            if sty != "int":
                self.err("E0042", f"`for` range start must be `int`, found `{ty_disp(sty)}`", self.ast.nodes[kids[0]].span)
            if ety != "int":
                self.err("E0042", f"`for` range end must be `int`, found `{ty_disp(ety)}`", self.ast.nodes[kids[1]].span)
            self.push_scope()
            self.declare(n.text, "int")
            self.loop_depth += 1
            self.check_block(kids[2])
            self.loop_depth -= 1
            self.pop_scope()
            return true
        if k == "ForEach":
            ity = self.check_expr(kids[0])
            ety2 = "int"
            if ty_is_list(ity):
                ety2 = ty_list_elem(ity)
            else:
                self.err("E0043", f"`for ... in` requires a list, found `{ty_disp(ity)}`", self.ast.nodes[kids[0]].span)
            self.push_scope()
            self.declare(n.text, ety2)
            self.loop_depth += 1
            self.check_block(kids[1])
            self.loop_depth -= 1
            self.pop_scope()
            return true
        if k == "Try":
            tfalls = self.check_block(kids[0])
            if kids[1] >= 0:
                self.push_scope()
                if len(n.text) > 0:
                    self.declare(n.text, "string")
                self.check_block(kids[1])
                self.pop_scope()
            if kids[2] >= 0:
                self.check_block(kids[2])
            return tfalls
        // Thread
        self.check_block(kids[0])
        return true

    // The variable an assignment target ultimately writes to (`x`, `x.f`, `x[i].f` -> `x`), "" if unknown.
    make lvalue_root(self, lv: int) -> string:
        k = self.ast.nodes[lv].kind
        if k == "LIdent":
            return self.ast.nodes[lv].text
        if k == "LField" or k == "LIndex":
            return self.expr_root(self.ast.nodes[lv].kids[0])
        return ""

    make expr_root(self, e: int) -> string:
        k = self.ast.nodes[e].kind
        if k == "Ident":
            return self.ast.nodes[e].text
        if k == "Field" or k == "Index":
            return self.expr_root(self.ast.nodes[e].kids[0])
        return ""

    make check_assign(self, target: int, ann: string, value: int, span: Span):
        tn = self.ast.nodes[target]
        tk = tn.kind
        tkids = tn.kids
        if tk == "LIdent":
            name = tn.text
            expected = ann
            if len(ann) == 0:
                expected = self.lookup(name)
            vty = self.check_expr_expecting(value, expected)
            if len(ann) > 0 and ann != vty:
                self.err("E0020", f"type mismatch in `{name}`: declared `{ty_disp(ann)}`, found `{ty_disp(vty)}`", span)
            existing = self.lookup(name)
            if len(existing) > 0:
                if existing != vty:
                    self.err("E0023", f"type mismatch: `{name}` is `{ty_disp(existing)}`, found `{ty_disp(vty)}`", span)
            else:
                final_ty = vty
                if len(ann) > 0:
                    final_ty = ann
                self.declare(name, final_ty)
            return
        if tk == "LField":
            field = tn.text
            fspan = tn.span
            bty = self.check_expr(tkids[0])
            exp_field = ""
            if self.ast.nodes[value].kind == "Null":
                exp_field = self.resolve_field_quiet(bty, field)
            vty2 = self.check_expr_expecting(value, exp_field)
            if self.is_deref(tkids[0]):
                self.err("E0099", "assigning a field through a dereferenced pointer isn't supported yet -- write `s = *p` first, then assign `s.field = ...` (this copies the struct rather than mutating through `p`, see docs/pointers.md)", fspan)
                return
            fty = self.resolve_field(bty, field, fspan)
            if len(fty) > 0 and fty != vty2:
                self.err("E0044", f"type mismatch: field `{field}` is `{ty_disp(fty)}`, found `{ty_disp(vty2)}`", fspan)
            return
        if tk == "LIndex":
            ispan = tn.span
            vty3 = self.check_expr(value)
            bty3 = self.check_expr(tkids[0])
            if self.is_deref(tkids[0]):
                self.err("E0099", "assigning an element through a dereferenced pointer isn't supported yet -- write `s = *p` first, then assign `s[i] = ...`", ispan)
                return
            elem = self.check_index(bty3, tkids[1], ispan)
            if len(elem) > 0 and elem != vty3:
                self.err("E0045", f"type mismatch: element is `{ty_disp(elem)}`, found `{ty_disp(vty3)}`", ispan)
            return
        // LDeref
        dspan = tn.span
        pty = self.check_expr(tkids[0])
        pointee = ""
        if ty_is_ptr(pty):
            pointee = ty_ptr_inner(pty)
        else:
            self.err("E0089", f"cannot dereference `{ty_disp(pty)}`: not a pointer", dspan)
        vty4 = self.check_expr_expecting(value, pointee)
        if len(pointee) > 0 and pointee != vty4:
            self.err("E0090", f"type mismatch: writing `{ty_disp(vty4)}` through a `ptr<{ty_disp(pointee)}>`", dspan)

    make resolve_field_quiet(self, bty: string, field: string) -> string:
        t = bty
        if ty_is_ptr(t):
            t = ty_ptr_inner(t)
        if not ty_is_named(t):
            return ""
        si = self.struct_of(t)
        if si < 0:
            return ""
        return self.field_ty(si, field)

    make check_expr_expecting(self, e: int, expected: string) -> string:
        if self.ast.nodes[e].kind == "Null":
            span = self.ast.nodes[e].span
            if len(expected) > 0:
                if ty_is_ptr(expected):
                    return expected
                self.err("E0091", f"`null` is not a valid `{ty_disp(expected)}`", span)
                return "int"
            self.err("E0091", "cannot infer the pointer type of `null` here -- annotate it, e.g. `p: ptr<int> = null`", span)
            return "int"
        if self.ast.nodes[e].kind == "Lambda":
            return self.check_lambda(e, expected)
        ety = self.check_expr(e)
        if expected == "num" and (ety == "int" or ety == "float"):
            self.wrap_num(e, ety)
            return "num"
        return ety

    // Replaces node `e` by a call of `fname` on a copy of the original node (the parent keeps pointing at `e`).
    make wrap_in_call(self, e: int, fname: string):
        n = self.ast.nodes[e]
        orig = self.ast.addl(n.kind, n.text, n.span, n.kids)
        kl: [int] = [orig]
        self.ast.nodes[e].kind = "Call"
        self.ast.nodes[e].text = fname
        self.ast.nodes[e].kids = kl

    // An `int` or `float` value used where a `num` is expected becomes a `num`.
    make wrap_num(self, e: int, ty: string):
        if ty == "float":
            self.wrap_in_call(e, "num__from_float")
        else:
            self.wrap_in_call(e, "num__from_int")

    // `a op b` where at least one side is a `num`: the node becomes a call of the matching `num__*` function.
    make num_binary(self, e: int, op: string, lhs: int, rhs: int, lt: string, rt: string, span: Span) -> string:
        fname = ""
        res = "num"
        if op == "Add":
            fname = "num__add"
        orif op == "Sub":
            fname = "num__sub"
        orif op == "Mul":
            fname = "num__mul"
        orif op == "Div":
            fname = "num__div"
        orif op == "Mod":
            fname = "num__mod"
        orif op == "Lt":
            fname = "num__lt"
            res = "bool"
        orif op == "Gt":
            fname = "num__gt"
            res = "bool"
        orif op == "LtEq":
            fname = "num__le"
            res = "bool"
        orif op == "GtEq":
            fname = "num__ge"
            res = "bool"
        orif op == "Eq":
            fname = "num__eq"
            res = "bool"
        orif op == "NotEq":
            fname = "num__ne"
            res = "bool"
        if len(fname) == 0:
            self.err("E0101", f"cannot apply `{op_symbol(op)}` to `{ty_disp(lt)}` and `{ty_disp(rt)}` -- `int` only", span)
            return "int"
        if (lt != "num" and lt != "int" and lt != "float") or (rt != "num" and rt != "int" and rt != "float"):
            self.err("E0126", f"cannot use `{op_symbol(op)}` on `{ty_disp(lt)}` and `{ty_disp(rt)}`: a `num` combines with `int`, `float` and `num` only", span)
            return res
        if lt != "num":
            self.wrap_num(lhs, lt)
        if rt != "num":
            self.wrap_num(rhs, rt)
        self.ast.nodes[e].kind = "Call"
        self.ast.nodes[e].text = fname
        return res

    make check_return(self, value: int, span: Span):
        expected_ret = ""
        if self.cur_has_ret:
            expected_ret = self.cur_ret
        actual = "()"
        if value >= 0:
            actual = self.check_expr_expecting(value, expected_ret)
        if self.cur_has_ret:
            if actual != self.cur_ret:
                self.err("E0031", f"mismatched return type: expected `{ty_disp(self.cur_ret)}`, found `{ty_disp(actual)}`", span)
        else:
            if self.is_unresolved_marker(value):
                self.ret_blocked = true
            orif not is_returnable(actual):
                self.err("E0039", f"function `{self.cur_fn}` may not return `{ty_disp(actual)}` -- functions may only return `int`/`float`/`bool`/`string`/nothing in Kite v0.1", span)
                self.lock_return_type("()")
            else:
                self.lock_return_type(actual)

    make is_unresolved_marker(self, value: int) -> bool:
        if value < 0:
            return false
        return self.ast.nodes[value].kind == "Call" and self.ast.nodes[value].text == self.cur_fn and not self.cur_has_ret

    // ---- expressions -----------------------------------------------------------------------
    make check_expr(self, e: int) -> string:
        n = self.ast.nodes[e]
        k = n.kind
        kids = n.kids
        span = n.span
        if k == "MethodCall":
            self.err("E0103", f"cannot resolve method `{n.text}`: the receiver's class is unknown here", span)
            return "()"
        if k == "EmptyList":
            return ty_list_of(self.ast.nodes[kids[0]].text)
        if k == "Named":
            self.err("E0102", "named arguments are only allowed in calls to Kite functions", span)
            return self.check_expr(kids[0])
        if k == "Int":
            return "int"
        if k == "Float":
            return "float"
        if k == "Bool":
            return "bool"
        if k == "Str":
            return "string"
        if k == "Ident":
            t = self.lookup(n.text)
            if len(t) > 0:
                return t
            if self.sig_idx.has(n.text) and not self.gen_idx.has(n.text):
                // a function used as a value
                fvt = self.fn_value_type(n.text, span)
                if len(fvt) > 0:
                    self.ast.nodes[e].text = self.ensure_fv_wrapper(n.text, span)
                    self.ast.nodes[e].kind = "FnRef"
                    return fvt
                return "int"
            self.err("E0021", f"cannot find variable `{n.text}` in this scope", span)
            return "int"
        if k == "ListLit":
            return self.check_list_literal(kids, span)
        if k == "TupleLit":
            tys: [string] = []
            for it in kids:
                append(tys, self.check_expr(it))
            i = 0
            while i < len(kids):
                if not is_scalar(tys[i]):
                    self.err("E0047c", f"tuple elements must be `int`, `float`, `bool`, or `string` in Kite v0.1, found `{ty_disp(tys[i])}` (nested collections are planned for v0.2)", self.ast.nodes[kids[i]].span)
                i += 1
            return "(" + join(tys, ", ") + ")"
        if k == "DictLit":
            return self.check_dict_literal(kids, span)
        if k == "Index":
            bty = self.check_expr(kids[0])
            r = self.check_index(bty, kids[1], span)
            if len(r) == 0:
                return "int"
            return r
        if k == "Field":
            field = n.text
            base = kids[0]
            if self.ast.nodes[base].kind == "Ident":
                bname = self.ast.nodes[base].text
                if self.enum_idx.has(bname):
                    ei = self.enum_idx.get(bname) - 1
                    if index_of_str(self.enums[ei].names, field) < 0:
                        self.err("E0072", f"enum `{bname}` has no variant `{field}`", span)
                    return "@" + bname
            bty2 = self.check_expr(base)
            if self.is_deref(base):
                self.err("E0099", "reading a field through a dereferenced pointer isn't supported yet -- write `s = *p` first, then use `s.field` (this copies the struct rather than reading through `p`, see docs/pointers.md)", span)
                return "int"
            r2 = self.resolve_field(bty2, field, span)
            if len(r2) == 0:
                return "int"
            return r2
        if k == "Unary":
            return self.check_unary(e, n.text, kids[0], span)
        if k == "Binary":
            return self.check_binary(e, n.text, kids[0], kids[1], span)
        if k == "Propagate":
            self.err("E0143", "`?` can only be used in an assignment, a call statement, a `return` or an `if` condition of a function that returns a `Result` or an `Option`", span)
            return "int"
        if k == "Lambda":
            return self.check_lambda(e, "")
        // nodes this pass already rewrote (an expression can be checked twice)
        if k == "FnRef" or k == "Closure":
            fsig = self.sigs[self.sig_idx.get(n.text) - 1]
            return "fn(" + join(slice_from(fsig.params, 1), ",") + ")->" + fsig.ret
        if k == "EnvLoad":
            return substr(n.text, find(n.text, "|") + 1, len(n.text))
        if k == "CallFn":
            return ty_fn_ret(self.lookup(self.ast.nodes[kids[0]].text))
        if k == "Call":
            vt0 = self.lookup(n.text)
            if len(vt0) > 0 and ty_is_fn(vt0):
                return self.check_call_fn(e, n.text, vt0, kids, span)
            if self.gen_idx.has(n.text):
                no_explicit: [string] = []
                return self.check_generic_call(e, n.text, kids, span, no_explicit)
            if contains_str(n.text, "<"):
                gname = substr(n.text, 0, find(n.text, "<"))
                if self.gen_idx.has(gname):
                    // explicit type arguments: `first<int>(xs)`
                    inner = substr(n.text, find(n.text, "<") + 1, len(n.text) - 1)
                    targs: [string] = []
                    for ta in split_top(inner):
                        ra = self.resolve_type_text(ta, span)
                        if self.enum_idx.has(ra):
                            ra = "@" + ra
                        append(targs, ra)
                    return self.check_generic_call(e, gname, kids, span, targs)
            if len(kids) == 1 and (n.text == "print" or n.text == "str"):
                // a `num` is shown through `num__str`
                if self.check_expr(kids[0]) == "num":
                    self.wrap_in_call(kids[0], "num__str")
            return self.check_call(n.text, kids, span)
        if k == "Await":
            return self.check_expr(kids[0])
        if k == "Null":
            self.err("E0091", "cannot infer the pointer type of `null` here -- annotate it, e.g. `p: ptr<int> = null`", span)
            return "int"
        if k == "Alloc":
            return self.check_alloc(self.ast.nodes[kids[0]].text, span)
        // AllocN
        cty = self.check_expr(kids[1])
        if cty != "int":
            self.err("E0093", f"`alloc_n` expects an `int` count, found `{ty_disp(cty)}`", self.ast.nodes[kids[1]].span)
        return self.check_alloc(self.ast.nodes[kids[0]].text, span)

    make check_alloc(self, t: string, span: Span) -> string:
        if ty_is_ptr(t):
            self.err("E0092", "`alloc`/`alloc_n` of a `ptr<...>` isn't supported yet -- pointers to pointers aren't implemented", span)
        orif ty_is_list(t) or ty_is_tuple(t) or ty_is_dict(t):
            self.err("E0092", f"`alloc`/`alloc_n` of `{ty_disp(t)}` isn't supported yet -- only scalar types and structs can be allocated", span)
        orif ty_is_named(t) and not self.has_struct(t):
            self.err("E0058", f"unknown type `{t}`", span)
        return ty_ptr_of(t)

    make check_list_literal(self, items: [int], span: Span) -> string:
        if len(items) == 0:
            self.err("E0046", "empty list literals need a type; write at least one element (e.g. `[0]` then remove it with future list ops)", span)
            return "[int]"
        first = self.check_expr(items[0])
        if not is_scalar(first) and not ty_is_named(first) and not ty_is_list(first):
            self.err("E0047b", f"list elements must be scalars, structs, enums or lists, found `{ty_disp(first)}`", self.ast.nodes[items[0]].span)
        i = 1
        while i < len(items):
            t = self.check_expr(items[i])
            if t != first:
                self.err("E0047", f"list elements must share one type: found `{ty_disp(first)}` and `{ty_disp(t)}`", self.ast.nodes[items[i]].span)
            i += 1
        return ty_list_of(first)

    make check_dict_literal(self, entries: [int], span: Span) -> string:
        parts: [string] = []
        seen: [string] = []
        for en in entries:
            key = self.ast.nodes[en].text
            if index_of_str(seen, key) >= 0:
                self.err("E0048", "duplicate dictionary key \"" + key + "\"", span)
            append(seen, key)
            val = self.ast.nodes[en].kids[0]
            t = self.check_expr(val)
            if not is_scalar(t):
                self.err("E0047d", f"dictionary values must be `int`, `float`, `bool`, or `string` in Kite v0.1, found `{ty_disp(t)}` (nested collections are planned for v0.2)", self.ast.nodes[val].span)
            append(parts, dump_quote(key) + ": " + t)
        return "{" + join(parts, ", ") + "}"

    // Element type of `base_ty[index]`, or "" when an error was reported.
    make check_index(self, base_ty: string, index: int, span: Span) -> string:
        ity = self.check_expr(index)
        if ity != "int":
            if ty_is_dict(base_ty) and ity == "string":
                ity = ity
            else:
                self.err("E0049", f"index must be `int`, found `{ty_disp(ity)}`", self.ast.nodes[index].span)
        ik = self.ast.nodes[index].kind
        if ty_is_list(base_ty):
            return ty_list_elem(base_ty)
        if ty_is_tuple(base_ty):
            elems = ty_tuple_elems(base_ty)
            if ik == "Int":
                v = to_int(self.ast.nodes[index].text)
                if v < 0 or v >= len(elems):
                    self.err("E0051", f"index {norm_int(self.ast.nodes[index].text)} is out of range for a tuple of size {str(len(elems))} (tuples are 0-indexed)", self.ast.nodes[index].span)
                    return ""
                return elems[v]
            self.err("E0052", "tuple index must be an integer literal (tuple elements can have different types)", self.ast.nodes[index].span)
            return ""
        if ty_is_dict(base_ty):
            if ik == "Str":
                df = ty_dict_fields(base_ty)
                q = dump_quote(self.ast.nodes[index].text)
                i = 0
                while i < len(df.keys):
                    if df.keys[i] == q:
                        return df.vals[i]
                    i += 1
                self.err("E0053", "dictionary has no key \"" + self.ast.nodes[index].text + "\"", self.ast.nodes[index].span)
                return ""
            self.err("E0054", "dictionary index must be a string literal key", self.ast.nodes[index].span)
            return ""
        if ty_is_ptr(base_ty):
            return ty_ptr_inner(base_ty)
        self.err("E0055", f"cannot index into a value of type `{ty_disp(base_ty)}`", span)
        return ""

    make resolve_field(self, base_ty: string, field: string, span: Span) -> string:
        if ty_is_ptr(base_ty) and ty_is_named(ty_ptr_inner(base_ty)):
            return self.resolve_field(ty_ptr_inner(base_ty), field, span)
        if ty_is_named(base_ty):
            si = self.struct_of(base_ty)
            if si < 0:
                self.err("E0057", f"unknown struct type `{base_ty}`", span)
                return ""
            ft = self.field_ty(si, field)
            if len(ft) == 0:
                self.err("E0056", f"struct `{base_ty}` has no field `{field}`", span)
            return ft
        self.err("E0058", f"cannot access field `{field}` on a value of type `{ty_disp(base_ty)}`", span)
        return ""

    make check_unary(self, un: int, op: string, e: int, span: Span) -> string:
        if op == "AddrOf":
            if self.ast.nodes[e].kind != "Ident":
                self.err("E0094", "`&` can only take the address of a local variable, e.g. `&x`", span)
                return "ptr<int>"
            name = self.ast.nodes[e].text
            t = self.lookup(name)
            if len(t) == 0:
                self.err("E0021", f"cannot find variable `{name}` in this scope", self.ast.nodes[e].span)
                t = "int"
            if not is_scalar(t):
                self.err("E0095", f"cannot take the address of a `{ty_disp(t)}` yet -- only `int`/`float`/`bool`/`string` locals are addressable in v0.1.3", span)
            return ty_ptr_of(t)
        ty = self.check_expr(e)
        if op == "Neg" and ty == "num":
            self.ast.nodes[un].kind = "Call"
            self.ast.nodes[un].text = "num__neg"
            return "num"
        if op == "Neg":
            if ty != "int" and ty != "float":
                self.err("E0025", f"cannot negate a value of type `{ty_disp(ty)}`", span)
            return ty
        if op == "Not":
            if ty != "bool":
                self.err("E0026", f"cannot apply `not` to a value of type `{ty_disp(ty)}`", span)
            return "bool"
        if op == "BitNot":
            if ty != "int":
                self.err("E0101", f"cannot apply `~` to a value of type `{ty_disp(ty)}` -- `int` only", span)
            return "int"
        // Deref
        if ty_is_ptr(ty):
            return ty_ptr_inner(ty)
        self.err("E0089", f"cannot dereference `{ty_disp(ty)}`: not a pointer", span)
        return "int"

    make check_binary(self, e: int, op: string, lhs: int, rhs: int, span: Span) -> string:
        if op == "Eq" or op == "NotEq":
            lty = ""
            rty = ""
            if self.ast.nodes[lhs].kind == "Null":
                rty = self.check_expr(rhs)
                lty = self.check_expr_expecting(lhs, rty)
            else:
                lty = self.check_expr(lhs)
                rty = self.check_expr_expecting(rhs, lty)
            if lty == "num" or rty == "num":
                return self.num_binary(e, op, lhs, rhs, lty, rty, span)
            if lty != rty:
                self.err("E0028", f"cannot compare `{ty_disp(lty)}` and `{ty_disp(rty)}` with `{op_symbol(op)}`", span)
            return "bool"
        lt = self.check_expr(lhs)
        rt = self.check_expr(rhs)
        if lt == "num" or rt == "num":
            return self.num_binary(e, op, lhs, rhs, lt, rt, span)
        if op == "Add" or op == "Sub":
            if op == "Add" and lt == "string" and rt == "string":
                return "string"
            if ty_is_ptr(lt) and rt == "int":
                return lt
            if lt == "int" and ty_is_ptr(rt) and op == "Add":
                return rt
            if lt != rt or (lt != "int" and lt != "float"):
                self.err("E0027", f"cannot apply arithmetic operator to `{ty_disp(lt)}` and `{ty_disp(rt)}`", span)
                return "int"
            return lt
        if op == "Mul" or op == "Div" or op == "Mod":
            if lt != rt or (lt != "int" and lt != "float"):
                self.err("E0027", f"cannot apply arithmetic operator to `{ty_disp(lt)}` and `{ty_disp(rt)}`", span)
                return "int"
            if op == "Mod" and lt == "float":
                self.err("E0027", "the `%` operator requires `int` operands", span)
                return "float"
            return lt
        if op == "Lt" or op == "Gt" or op == "LtEq" or op == "GtEq":
            if lt != rt or (lt != "int" and lt != "float" and lt != "string"):
                self.err("E0028", f"cannot compare `{ty_disp(lt)}` and `{ty_disp(rt)}` with `{op_symbol(op)}`", span)
            return "bool"
        if op == "And" or op == "Or":
            if lt != "bool" or rt != "bool":
                self.err("E0029", f"operator `{op_symbol(op)}` requires `bool` operands, found `{ty_disp(lt)}` and `{ty_disp(rt)}`", span)
            return "bool"
        // BitAnd BitOr BitXor Shl Shr
        if lt != "int" or rt != "int":
            self.err("E0101", f"cannot apply `{op_symbol(op)}` to `{ty_disp(lt)}` and `{ty_disp(rt)}` -- `int` only", span)
        return "int"

    make check_all(self, args: [int]):
        for a in args:
            self.check_expr(a)

    // Checks argument `i` of a builtin against an expected simple type; reports `code` otherwise.
    make arg_is(self, args: [int], i: int, want: string, code: string, msg_pre: string, msg_post: string):
        if len(args) > i:
            t = self.check_expr(args[i])
            if t != want:
                self.err(code, msg_pre + ty_disp(t) + msg_post, self.ast.nodes[args[i]].span)

    // Matches the declared parameter type `pat` (which mentions type parameters `tn`) against the argument type
    // `actual`, recording the bindings in `ub_names` / `ub_vals`.
    // `Box<int>` -> `Box__int` (instantiating the generic record on first use); other text is returned unchanged.
    make resolve_type_text(self, text: string, span: Span) -> string:
        if not contains_str(text, "<"):
            return text
        out = ""
        i = 0
        n = len(text)
        while i < n:
            c = char_at(text, i)
            if is_word_char(c):
                j = i
                while j < n and is_word_char(char_at(text, j)):
                    j += 1
                word = substr(text, i, j)
                if j < n and char_at(text, j) == 60 and self.gstruct_idx.has(word):
                    depth = 0
                    k = j
                    while k < n:
                        ch = char_at(text, k)
                        if ch == 60:
                            depth += 1
                        orif ch == 62:
                            depth -= 1
                            if depth == 0:
                                break
                        k += 1
                    inner = substr(text, j + 1, k)
                    rargs: [string] = []
                    for a in split_top(inner):
                        ra = self.resolve_type_text(a, span)
                        if self.enum_idx.has(ra):
                            ra = "@" + ra
                        append(rargs, ra)
                    out = out + self.instantiate_struct(word, rargs, span)
                    i = k + 1
                else:
                    out = out + word
                    i = j
            else:
                out = out + chr(c)
                i += 1
        return out

    make instantiate_struct(self, base: string, args: [string], span: Span) -> string:
        g = self.gstruct_nodes[self.gstruct_idx.get(base) - 1]
        gk = self.ast.nodes[g].kids
        flags = self.ast.nodes[gk[2]].text
        tn = split(substr(flags, find(flags, "generic:") + 8, len(flags)), ",")
        if len(tn) != len(args):
            self.err("E0125", f"`{base}` takes {str(len(tn))} type argument(s), found {str(len(args))}", span)
            return base
        mangled = base + "__" + mangle_type(join(args, "_"))
        if self.struct_idx.has(mangled):
            return mangled
        append(self.structs, StructT())
        si = len(self.structs) - 1
        self.struct_idx.set(mangled, len(self.structs))
        append(self.ginst_names, mangled)
        append(self.ginst_base, base)
        append(self.ginst_args, join(args, "|"))
        fl = self.clone_subst(gk[1], tn, args)
        sk: [int] = [-1, fl]
        nf = self.ast.addl("Struct", mangled, self.ast.nodes[g].span, sk)
        sd = StructT()
        for fd in self.ast.nodes[fl].kids:
            tnode = self.ast.nodes[fd].kids[0]
            ftext = self.resolve_type_text(self.ast.nodes[tnode].text, span)
            if self.enum_idx.has(ftext):
                ftext = "@" + ftext
            self.ast.nodes[tnode].text = ftext
            if not field_type_ok(ftext):
                self.err("E0067", f"field `{self.ast.nodes[fd].text}` of `{mangled}` has the unsupported type `{ty_disp(ftext)}`", self.ast.nodes[fd].span)
            append(sd.names, self.ast.nodes[fd].text)
            append(sd.types, ftext)
        self.structs[si] = sd
        append(self.ast.nodes[self.structs_l].kids, nf)
        return mangled

    // Rewrites every generic application (`Box<int>` in a type, `Box<int>()` as a call) under `id` to its instance.
    make walk_resolve(self, id: int):
        if id < 0:
            return
        k = self.ast.nodes[id].kind
        if k == "Type" or k == "Call":
            tx = self.ast.nodes[id].text
            if contains_str(tx, "<"):
                self.ast.nodes[id].text = self.resolve_type_text(tx, self.ast.nodes[id].span)
        kl = self.ast.nodes[id].kids
        for c in kl:
            self.walk_resolve(c)

    // A named function used as a value is reached through `name__fv`, a function that takes the (unused) closure block first.
    make ensure_fv_wrapper(self, name: string, span: Span) -> string:
        wname = name + "__fv"
        if self.sig_idx.has(wname):
            return wname
        sig0 = self.sigs[self.sig_idx.get(name) - 1]
        envt = self.ast.add0("Type", "ptr<int>", span)
        envf = self.ast.add0("Flags", "", span)
        params: [int] = [self.ast.add3("Param", "__env", span, envt, -1, envf)]
        cargs: [int] = []
        i = 0
        for pt in sig0.params:
            pn = "p" + str(i)
            ptn = self.ast.add0("Type", pt, span)
            pf = self.ast.add0("Flags", "", span)
            append(params, self.ast.add3("Param", pn, span, ptn, -1, pf))
            append(cargs, self.ast.add0("Ident", pn, span))
            i += 1
        call = self.ast.addl("Call", name, span, cargs)
        stmt = -1
        rnode = -1
        if sig0.ret != "()":
            rnode = self.ast.add0("Type", sig0.ret, span)
            stmt = self.ast.add1("Return", "", span, call)
        else:
            stmt = self.ast.add1("ExprStmt", "", span, call)
        sl: [int] = [stmt]
        blk = self.ast.addl("Block", "", span, sl)
        plist = self.ast.addl("List", "", span, params)
        flg = self.ast.add0("Flags", "", span)
        fnode = self.ast.add4("Function", wname, span, plist, rnode, flg, blk)
        sig = SigT()
        append(sig.params, "ptr<int>")
        for pt3 in sig0.params:
            append(sig.params, pt3)
        sig.ret = sig0.ret
        sig.has_ret = true
        append(self.sigs, sig)
        self.sig_idx.set(wname, len(self.sigs))
        append(self.pending, fnode)
        return wname

    // The variables of the enclosing function that the lambda body `body` uses (its captures), with their types.
    make collect_captures(self, body: int, pnames: [string], cnames: [string], ctypes: [string]):
        stack: [int] = [body]
        while len(stack) > 0:
            nd = pop(stack)
            if nd < 0:
                continue
            k = self.ast.nodes[nd].kind
            if k == "Ident" or k == "Call":
                nm = self.ast.nodes[nd].text
                if index_of_str(pnames, nm) < 0 and index_of_str(cnames, nm) < 0:
                    vt = self.lookup(nm)
                    if len(vt) > 0 and (k == "Ident" or ty_is_fn(vt)):
                        append(cnames, nm)
                        append(ctypes, vt)
            kl = self.ast.nodes[nd].kids
            for c in kl:
                append(stack, c)

    // The type of the function named `name` used as a value, or "" (with an error) when that is not possible.
    make fn_value_type(self, name: string, span: Span) -> string:
        sig = self.sigs[self.sig_idx.get(name) - 1]
        if not sig.has_ret:
            self.err("E0135", f"give `{name}` an explicit `-> Type` before using it as a value", span)
            return ""
        ok = fn_value_type_ok(sig.ret)
        for pt in sig.params:
            if not fn_value_type_ok(pt):
                ok = false
        if not ok:
            self.err("E0131", f"`{name}` cannot be used as a value: function values take and return `int`, `float`, `bool`, `string`, pointers and enums only", span)
            return ""
        return "fn(" + join(sig.params, ",") + ")->" + sig.ret

    // Calling a variable that holds a function: `f(3)`.
    make check_call_fn(self, e: int, name: string, ft: string, args: [int], span: Span) -> string:
        ps = ty_fn_params(ft)
        if len(args) != len(ps):
            self.err("E0136", f"`{name}` is a `{ty_disp(ft)}` and takes {str(len(ps))} argument(s), found {str(len(args))}", span)
            self.check_all(args)
            return ty_fn_ret(ft)
        i = 0
        irtys: [string] = []
        while i < len(args):
            at = self.check_expr_expecting(args[i], ps[i])
            if at != ps[i] and not self.is_subtype(at, ps[i]):
                self.err("E0137", f"argument {str(i + 1)} of `{name}` should be `{ty_disp(ps[i])}`, found `{ty_disp(at)}`", self.ast.nodes[args[i]].span)
            i += 1
        callee = self.ast.add0("Ident", name, span)
        kl: [int] = [callee]
        for a in args:
            append(kl, a)
        self.ast.nodes[e].kind = "CallFn"
        self.ast.nodes[e].text = ir_type(ty_fn_ret(ft))
        self.ast.nodes[e].kids = kl
        return ty_fn_ret(ft)

    // A lambda `|x, y| expr`: its parameter types come from the annotations or from the expected function type; the body
    // is checked without access to the variables around it (closures cannot capture yet), then lifted to a function of its
    // own, and the node becomes a reference to that function.
    make check_lambda(self, e: int, expected: string) -> string:
        lk = self.ast.nodes[e].kids
        pl = self.ast.nodes[lk[0]].kids
        body = lk[1]
        span = self.ast.nodes[e].span
        exp_params: [string] = []
        exp_ret = "?"
        if ty_is_fn(expected):
            exp_params = ty_fn_params(expected)
            exp_ret = ty_fn_ret(expected)
            if len(exp_params) != len(pl):
                self.err("E0138", f"this lambda takes {str(len(pl))} parameter(s) but a `{ty_disp(expected)}` is expected", span)
                return expected
        ptys: [string] = []
        i = 0
        while i < len(pl):
            pk = self.ast.nodes[pl[i]].kids
            ty = ""
            if pk[0] >= 0:
                ty = self.resolve_type_text(self.ast.nodes[pk[0]].text, span)
                if self.enum_idx.has(ty):
                    ty = "@" + ty
            orif i < len(exp_params):
                ty = exp_params[i]
            if len(ty) == 0 or ty == "?":
                self.err("E0133", f"cannot infer the type of the lambda parameter `{self.ast.nodes[pl[i]].text}`; write it like `|{self.ast.nodes[pl[i]].text}: int|`", self.ast.nodes[pl[i]].span)
                ty = "int"
            if not fn_value_type_ok(ty):
                self.err("E0131", f"lambda parameters can be `int`, `float`, `bool`, `string`, pointers and enums only, found `{ty_disp(ty)}`", self.ast.nodes[pl[i]].span)
            append(ptys, ty)
            i += 1
        // the variables of the enclosing function that the body uses are captured (copied when the lambda is created)
        pnames: [string] = []
        for pp in pl:
            append(pnames, self.ast.nodes[pp].text)
        cnames: [string] = []
        ctypes: [string] = []
        self.collect_captures(body, pnames, cnames, ctypes)
        for ct in ctypes:
            if not fn_value_type_ok(ct):
                self.err("E0139", f"a lambda cannot capture a value of type `{ty_disp(ct)}` yet: captured variables are `int`, `float`, `bool`, `string`, pointers, enums or functions", span)
        // check the body in a scope that holds the parameters and the captured variables
        saved_names = self.var_names
        saved_types = self.var_types
        saved_marks = self.marks
        fresh_n: [string] = []
        fresh_t: [string] = []
        fresh_m: [int] = []
        self.var_names = fresh_n
        self.var_types = fresh_t
        self.marks = fresh_m
        i = 0
        while i < len(pl):
            self.declare(self.ast.nodes[pl[i]].text, ptys[i])
            i += 1
        i = 0
        while i < len(cnames):
            self.declare(cnames[i], ctypes[i])
            i += 1
        bt = ""
        if len(exp_ret) > 0 and exp_ret != "?" and exp_ret != "()":
            bt = self.check_expr_expecting(body, exp_ret)
        else:
            bt = self.check_expr(body)
        self.var_names = saved_names
        self.var_types = saved_types
        self.marks = saved_marks
        ret = bt
        if len(exp_ret) > 0 and exp_ret != "?" and exp_ret != "()" and bt != exp_ret and not self.is_subtype(bt, exp_ret):
            self.err("E0134", f"this lambda returns `{ty_disp(bt)}` but a `{ty_disp(exp_ret)}` is expected", self.ast.nodes[body].span)
            ret = exp_ret
        if not fn_value_type_ok(ret):
            self.err("E0131", f"a lambda can return `int`, `float`, `bool`, `string`, pointers and enums only, found `{ty_disp(ret)}`", self.ast.nodes[body].span)
        // lift: a new top-level function `lambda__N`
        lname = "lambda__" + str(self.lambda_count)
        self.lambda_count += 1
        params2: [int] = []
        envt = self.ast.add0("Type", "ptr<int>", span)
        envf = self.ast.add0("Flags", "", span)
        append(params2, self.ast.add3("Param", "__env", span, envt, -1, envf))
        i = 0
        while i < len(pl):
            tn2 = self.ast.add0("Type", ptys[i], span)
            fl2 = self.ast.add0("Flags", "", span)
            append(params2, self.ast.add3("Param", self.ast.nodes[pl[i]].text, self.ast.nodes[pl[i]].span, tn2, -1, fl2))
            i += 1
        plist = self.ast.addl("List", "", span, params2)
        rnode = -1
        if ret != "()":
            rnode = self.ast.add0("Type", ret, span)
        stmt = -1
        if ret != "()":
            stmt = self.ast.add1("Return", "", span, body)
        else:
            stmt = self.ast.add1("ExprStmt", "", span, body)
        // the captured variables are loaded from the closure block first
        sl: [int] = []
        i = 0
        while i < len(cnames):
            lv = self.ast.add0("LIdent", cnames[i], span)
            ev = self.ast.add0("EnvLoad", str(i) + "|" + ctypes[i], span)
            append(sl, self.ast.add3("Assign", "", span, lv, -1, ev))
            i += 1
        append(sl, stmt)
        blk = self.ast.addl("Block", "", span, sl)
        flg = self.ast.add0("Flags", "", span)
        fnode = self.ast.add4("Function", lname, span, plist, rnode, flg, blk)
        sig = SigT()
        append(sig.params, "ptr<int>")
        for pt2 in ptys:
            append(sig.params, pt2)
        sig.ret = ret
        sig.has_ret = true
        append(self.sigs, sig)
        self.sig_idx.set(lname, len(self.sigs))
        append(self.pending, fnode)
        nk: [int] = []
        if len(cnames) == 0:
            self.ast.nodes[e].kind = "FnRef"
        else:
            self.ast.nodes[e].kind = "Closure"
            for cn in cnames:
                append(nk, self.ast.add0("Ident", cn, span))
        self.ast.nodes[e].text = lname
        self.ast.nodes[e].kids = nk
        return "fn(" + join(ptys, ",") + ")->" + ret

    make unify(self, pat: string, actual: string, tn: [string]) -> bool:
        if index_of_str(tn, pat) >= 0:
            j = index_of_str(self.ub_names, pat)
            if j >= 0:
                return self.ub_vals[j] == actual
            append(self.ub_names, pat)
            append(self.ub_vals, actual)
            return true
        if ty_is_fn(pat):
            if not ty_is_fn(actual):
                return false
            fp = ty_fn_params(pat)
            fa = ty_fn_params(actual)
            if len(fp) != len(fa):
                return false
            fq = 0
            while fq < len(fp):
                if not self.unify(fp[fq], fa[fq], tn):
                    return false
                fq += 1
            return self.unify(ty_fn_ret(pat), ty_fn_ret(actual), tn)
        if ty_is_list(pat):
            if not ty_is_list(actual):
                return false
            return self.unify(ty_list_elem(pat), ty_list_elem(actual), tn)
        if starts_with(pat, "ptr<") and ends_with(pat, ">"):
            if not (starts_with(actual, "ptr<") and ends_with(actual, ">")):
                return false
            return self.unify(substr(pat, 4, len(pat) - 1), substr(actual, 4, len(actual) - 1), tn)
        lt = find(pat, "<")
        if lt > 0 and ends_with(pat, ">") and self.gstruct_idx.has(substr(pat, 0, lt)):
            gi = index_of_str(self.ginst_names, actual)
            if gi < 0 or self.ginst_base[gi] != substr(pat, 0, lt):
                return false
            pargs = split_top(substr(pat, lt + 1, len(pat) - 1))
            aargs = split(self.ginst_args[gi], "|")
            if len(pargs) != len(aargs):
                return false
            q = 0
            while q < len(pargs):
                if not self.unify(pargs[q], aargs[q], tn):
                    return false
                q += 1
            return true
        return pat == actual or self.is_subtype(actual, pat)

    make clone_subst(self, id: int, tn: [string], tv: [string]) -> int:
        n = self.ast.nodes[id]
        kids2: [int] = []
        for c in n.kids:
            if c < 0:
                append(kids2, -1)
            else:
                append(kids2, self.clone_subst(c, tn, tv))
        text = n.text
        if n.kind == "Type" or (n.kind == "Call" and contains_str(text, "<")):
            text = subst_type(text, tn, tv)
        return self.ast.addl(n.kind, text, n.span, kids2)

    make make_instance(self, f: int, inst: string, tn: [string], tv: [string]):
        nf = self.clone_subst(f, tn, tv)
        self.walk_resolve(nf)
        self.ast.nodes[nf].text = inst
        fk2 = self.ast.nodes[nf].kids
        flags = self.ast.nodes[fk2[2]].text
        self.ast.nodes[fk2[2]].text = trim(substr(flags, 0, find(flags, "generic:")))
        sig = SigT()
        for p in self.ast.nodes[fk2[0]].kids:
            append(sig.params, self.ast.nodes[self.ast.nodes[p].kids[0]].text)
        sig.ret = "()"
        if fk2[1] >= 0:
            sig.ret = self.ast.nodes[fk2[1]].text
        sig.has_ret = true
        append(self.sigs, sig)
        self.sig_idx.set(inst, len(self.sigs))
        self.inst_idx.set(inst, 1)
        append(self.pending, nf)

    // A call of a generic function: infer the type parameters from the argument types, instantiate the function
    // for them (once) and point the call at the instance.
    make check_generic_call(self, e: int, name: string, args: [int], span: Span, explicit: [string]) -> string:
        f = self.gen_nodes[self.gen_idx.get(name) - 1]
        fk = self.ast.nodes[f].kids
        flags = self.ast.nodes[fk[2]].text
        tn = split(substr(flags, find(flags, "generic:") + 8, len(flags)), ",")
        pl = self.ast.nodes[fk[0]].kids
        ats: [string] = []
        for a in args:
            if self.ast.nodes[a].kind == "Lambda":
                append(ats, "")
            else:
                append(ats, self.check_expr(a))
        if len(args) != len(pl):
            self.err("E0121", f"`{name}` takes {str(len(pl))} argument(s), found {str(len(args))}", span)
            return "()"
        clear(self.ub_names)
        clear(self.ub_vals)
        if len(explicit) > 0:
            // `first<int>(xs)`: the type arguments are given
            if len(explicit) > len(tn):
                self.err("E0127", f"`{name}` takes {str(len(tn))} type argument(s), found {str(len(explicit))}", span)
                return "()"
            q = 0
            while q < len(explicit):
                append(self.ub_names, tn[q])
                append(self.ub_vals, explicit[q])
                q += 1
        i = 0
        while i < len(pl):
            pty = self.ast.nodes[self.ast.nodes[pl[i]].kids[0]].text
            if len(ats[i]) > 0 and not self.unify(pty, ats[i], tn):
                self.err("E0122", f"argument {str(i + 1)} of `{name}` should be `{ty_disp(subst_type(pty, self.ub_names, self.ub_vals))}`, found `{ty_disp(ats[i])}`", self.ast.nodes[args[i]].span)
                return "()"
            i += 1
        // lambdas last: their parameter types come from what the other arguments already fixed
        i = 0
        while i < len(pl):
            if len(ats[i]) == 0:
                pty2 = self.ast.nodes[self.ast.nodes[pl[i]].kids[0]].text
                exp2 = subst_type(pty2, self.ub_names, self.ub_vals)
                // a type parameter that is still unknown (usually the result type) is left to the lambda's body
                for tpn in tn:
                    if index_of_str(self.ub_names, tpn) < 0 and ty_is_fn(exp2):
                        rpart = ty_fn_ret(exp2)
                        if rpart == tpn:
                            exp2 = substr(exp2, 0, fn_close(exp2) + 3) + "?"
                ats[i] = self.check_lambda(args[i], exp2)
                if not self.unify(pty2, ats[i], tn):
                    self.err("E0122", f"argument {str(i + 1)} of `{name}` should be `{ty_disp(subst_type(pty2, self.ub_names, self.ub_vals))}`, found `{ty_disp(ats[i])}`", self.ast.nodes[args[i]].span)
                    return "()"
            i += 1
        tv: [string] = []
        for t in tn:
            j = index_of_str(self.ub_names, t)
            if j < 0:
                self.err("E0123", f"cannot infer the type parameter `{t}` of `{name}` from its arguments", span)
                return "()"
            append(tv, self.ub_vals[j])
        inst = name + "__" + mangle_type(join(tv, "_"))
        if not self.inst_idx.has(inst):
            self.make_instance(f, inst, tn, tv)
        self.ast.nodes[e].text = inst
        return self.sigs[self.sig_idx.get(inst) - 1].ret

    make check_call(self, name: string, args: [int], span: Span) -> string:
        na = len(args)
        if name == "print":
            if na != 1:
                self.err("E0032", "`print` takes exactly 1 argument, found " + str(na), span)
            self.check_all(args)
            return "()"
        if name == "pop" or name == "clear" or name == "remove" or name == "insert":
            want = 3
            if name == "pop" or name == "clear":
                want = 1
            orif name == "remove":
                want = 2
            if na != want:
                self.err("E0110", f"`{name}` takes exactly {str(want)} argument(s), found {str(na)}", span)
                self.check_all(args)
                return "()"
            lty = self.check_expr(args[0])
            if not ty_is_list(lty):
                self.err("E0064", f"`{name}` expects a list as its first argument, found `{ty_disp(lty)}`", self.ast.nodes[args[0]].span)
                return "()"
            elem = ty_list_elem(lty)
            if want >= 2:
                it = self.check_expr(args[1])
                if it != "int":
                    self.err("E0111", f"list index must be `int`, found `{ty_disp(it)}`", self.ast.nodes[args[1]].span)
            if name == "insert":
                vt = self.check_expr(args[2])
                if elem == "num" and (vt == "int" or vt == "float"):
                    self.wrap_num(args[2], vt)
                    vt = "num"
                if vt != elem:
                    self.err("E0063", f"cannot insert a `{ty_disp(vt)}` into a list of `{ty_disp(elem)}`", self.ast.nodes[args[2]].span)
            if name == "pop" or name == "remove":
                return elem
            return "()"
        if name == "exit":
            if na != 1:
                self.err("E0112", "`exit` takes exactly 1 argument (the exit code)", span)
            for a in args:
                t = self.check_expr(a)
                if t != "int":
                    self.err("E0113", f"`exit` expects an `int`, found `{ty_disp(t)}`", self.ast.nodes[a].span)
            return "()"
        if name == "append":
            if na != 2:
                self.err("E0062", "`append` takes exactly 2 arguments (list, value), found " + str(na), span)
                self.check_all(args)
                return "()"
            lty2 = self.check_expr(args[0])
            vty = self.check_expr(args[1])
            if ty_is_list(lty2) and ty_list_elem(lty2) == "num" and (vty == "int" or vty == "float"):
                self.wrap_num(args[1], vty)
                vty = "num"
            if ty_is_list(lty2):
                if ty_list_elem(lty2) != vty:
                    self.err("E0063", f"cannot append a `{ty_disp(vty)}` to a list of `{ty_disp(ty_list_elem(lty2))}`", self.ast.nodes[args[1]].span)
            else:
                self.err("E0064", f"`append` expects a list as its first argument, found `{ty_disp(lty2)}`", self.ast.nodes[args[0]].span)
            return "()"
        if name == "len":
            if na != 1:
                self.err("E0065", "`len` takes exactly 1 argument, found " + str(na), span)
            if na > 0:
                t2 = self.check_expr(args[0])
                if not ty_is_list(t2) and t2 != "string":
                    self.err("E0066", f"`len` expects a list or string, found `{ty_disp(t2)}`", self.ast.nodes[args[0]].span)
            return "int"
        if name == "str":
            if na != 1:
                self.err("E0090", "`str` takes exactly 1 argument, found " + str(na), span)
            if na > 0:
                t3 = self.check_expr(args[0])
                if not ty_is_scalar_name(t3):
                    self.err("E0091", f"`str` expects an `int`, `float`, `bool` or `string`, found `{ty_disp(t3)}`", self.ast.nodes[args[0]].span)
            return "string"
        if name == "char_at":
            if na != 2:
                self.err("E0075", "`char_at` takes exactly 2 arguments (string, index), found " + str(na), span)
            self.arg_is(args, 0, "string", "E0076", "`char_at` expects a string, found `", "`")
            self.arg_is(args, 1, "int", "E0077", "`char_at` expects an `int` index, found `", "`")
            return "int"
        if name == "substr":
            if na != 3:
                self.err("E0078", "`substr` takes exactly 3 arguments (string, start, end), found " + str(na), span)
            self.arg_is(args, 0, "string", "E0079", "`substr` expects a string, found `", "`")
            i = 1
            while i < na:
                self.arg_is(args, i, "int", "E0080", "`substr` expects `int` bounds, found `", "`")
                i += 1
            return "string"
        if name == "read_file":
            if na != 1:
                self.err("E0081", "`read_file` takes exactly 1 argument (path), found " + str(na), span)
            self.arg_is(args, 0, "string", "E0082", "`read_file` expects a string path, found `", "`")
            return "string"
        if name == "write_file":
            if na != 2:
                self.err("E0083", "`write_file` takes exactly 2 arguments (path, content), found " + str(na), span)
            self.arg_is(args, 0, "string", "E0084", "`write_file` expects a string path, found `", "`")
            self.arg_is(args, 1, "string", "E0085", "`write_file` expects string content, found `", "`")
            return "bool"
        if name == "arg_count":
            if na != 0:
                self.err("E0086", "`arg_count` takes no arguments, found " + str(na), span)
            return "int"
        if name == "arg":
            if na != 1:
                self.err("E0087", "`arg` takes exactly 1 argument (a 1-based index), found " + str(na), span)
            self.arg_is(args, 0, "int", "E0088", "`arg` expects an `int` index, found `", "`")
            return "string"
        if name == "free":
            if na != 1:
                self.err("E0096", "`free` takes exactly 1 argument (a pointer), found " + str(na), span)
            if na > 0:
                t4 = self.check_expr(args[0])
                if not ty_is_ptr(t4):
                    self.err("E0097", f"`free` expects a `ptr<T>`, found `{ty_disp(t4)}`", self.ast.nodes[args[0]].span)
            return "()"
        if name == "ptr_to_int":
            if na != 1:
                self.err("E0140", "`ptr_to_int` takes exactly 1 argument, found " + str(na), span)
            if na > 0:
                pit = self.check_expr(args[0])
                if not ty_is_ptr(pit):
                    self.err("E0141", f"`ptr_to_int` expects a `ptr<T>`, found `{ty_disp(pit)}`", self.ast.nodes[args[0]].span)
            return "int"
        if name == "int_to_ptr":
            if na != 1:
                self.err("E0142", "`int_to_ptr` takes exactly 1 argument, found " + str(na), span)
            self.arg_is(args, 0, "int", "E0143", "`int_to_ptr` expects an `int` address, found `", "`")
            return "ptr<int>"
        if name == "float_of":
            if na != 1:
                self.err("E0150", "`float_of` takes exactly 1 argument, found " + str(na), span)
            self.arg_is(args, 0, "int", "E0151", "`float_of` expects an `int`, found `", "`")
            return "float"
        if name == "int_of":
            if na != 1:
                self.err("E0152", "`int_of` takes exactly 1 argument, found " + str(na), span)
            self.arg_is(args, 0, "float", "E0153", "`int_of` expects a `float`, found `", "`")
            return "int"
        if name == "realloc_n":
            if na != 2:
                self.err("E0120", "`realloc_n` takes exactly 2 arguments (pointer, new element count), found " + str(na), span)
                self.check_all(args)
                return "ptr<int>"
            rpt = self.check_expr(args[0])
            self.arg_is(args, 1, "int", "E0121", "`realloc_n` expects an `int` count, found `", "`")
            if not ty_is_ptr(rpt):
                self.err("E0122", f"`realloc_n` expects a `ptr<T>`, found `{ty_disp(rpt)}`", self.ast.nodes[args[0]].span)
                return "ptr<int>"
            return rpt
        if name == "copy_n":
            if na != 3:
                self.err("E0123", "`copy_n` takes exactly 3 arguments (destination, source, element count), found " + str(na), span)
                self.check_all(args)
                return "()"
            dpt = self.check_expr(args[0])
            spt = self.check_expr(args[1])
            self.arg_is(args, 2, "int", "E0124", "`copy_n` expects an `int` count, found `", "`")
            if not ty_is_ptr(dpt) or not ty_is_ptr(spt):
                self.err("E0125", f"`copy_n` expects two `ptr<T>` arguments, found `{ty_disp(dpt)}` and `{ty_disp(spt)}`", span)
            orif dpt != spt:
                self.err("E0125", f"`copy_n` needs pointers to the same type, found `{ty_disp(dpt)}` and `{ty_disp(spt)}`", span)
            return "()"
        if name == "zero_n":
            if na != 2:
                self.err("E0126", "`zero_n` takes exactly 2 arguments (pointer, element count), found " + str(na), span)
                self.check_all(args)
                return "()"
            zpt = self.check_expr(args[0])
            self.arg_is(args, 1, "int", "E0127", "`zero_n` expects an `int` count, found `", "`")
            if not ty_is_ptr(zpt):
                self.err("E0128", f"`zero_n` expects a `ptr<T>`, found `{ty_disp(zpt)}`", self.ast.nodes[args[0]].span)
            return "()"
        if name == "spawn":
            if na != 2:
                self.err("E0130", "`spawn` takes exactly 2 arguments (a function name and an `int` argument), found " + str(na), span)
                self.check_all(args)
                return "int"
            fnode = self.ast.nodes[args[0]]
            if fnode.kind != "Ident" or not self.sig_idx.has(fnode.text):
                self.err("E0131", "`spawn` expects the name of a function as its first argument, e.g. `spawn(worker, 1)`", fnode.span)
            else:
                ssi = self.sig_idx.get(fnode.text) - 1
                if len(self.sigs[ssi].params) != 1 or self.sigs[ssi].params[0] != "int":
                    self.err("E0132", "the function given to `spawn` must take exactly one `int` parameter", fnode.span)
                if self.sigs[ssi].has_ret and not (self.sigs[ssi].ret == "()" or self.sigs[ssi].ret == "int"):
                    self.err("E0133", "the function given to `spawn` must return nothing or an `int`", fnode.span)
            self.arg_is(args, 1, "int", "E0134", "`spawn` expects an `int` argument, found `", "`")
            return "int"
        if name == "thread_join":
            if na != 1:
                self.err("E0135", "`thread_join` takes exactly 1 argument (a thread handle), found " + str(na), span)
            self.arg_is(args, 0, "int", "E0136", "`thread_join` expects an `int` handle, found `", "`")
            return "()"
        if self.has_struct(name):
            if na != 0:
                self.err("E0059", f"struct constructor `{name}()` takes no arguments", span)
            return name
        if not self.sig_idx.has(name):
            self.err("E0033", f"cannot find function `{name}` in this scope", span)
            self.check_all(args)
            return "int"
        si = self.sig_idx.get(name) - 1
        nparams = len(self.sigs[si].params)
        if na != nparams:
            self.err("E0034", f"function `{name}` expects {str(nparams)} argument(s), found {str(na)}", span)
        j = 0
        while j < na:
            expected = ""
            if j < nparams:
                expected = self.sigs[si].params[j]
            aty = self.check_expr_expecting(args[j], expected)
            if len(expected) > 0:
                if expected != aty and not self.is_subtype(aty, expected) and not (ends_with(self.cur_fn, "__vcall") and self.is_subtype(expected, aty)):
                    self.err("E0035", "argument " + str(j + 1) + f" to `{name}` has type `{ty_disp(aty)}`, expected `{ty_disp(expected)}`", self.ast.nodes[args[j]].span)
            j += 1
        if self.sigs[si].has_ret:
            return self.sigs[si].ret
        if name != self.cur_fn:
            self.err("E0060", f"cannot infer the return type of `{name}` here because it is still being inferred; add an explicit `-> Type` to `{name}` (or to `{self.cur_fn}`) to break the cycle", span)
        return "()"

make index_of_str(xs: [string], name: string) -> int:
    i = 0
    while i < len(xs):
        if xs[i] == name:
            return i
        i += 1
    return -1

// ---- driver (port of analyze_impl) ---------------------------------------------------------

make is_extern_fn(ast: Ast, f: int) -> bool:
    return contains_str(ast.nodes[ast.nodes[f].kids[2]].text, "extern")

// `A` -> `@A` for a type node naming a known enum (only the type itself, not nested ones).
make fix_ty_node(ast: Ast, tn: int, enum_idx: StrMap_int) -> int:
    if tn < 0:
        return 0
    t = ast.nodes[tn].text
    if ty_is_named(t) and enum_idx.has(t):
        ast.nodes[tn].text = "@" + t
    return 0

make fix_block_types(ast: Ast, b: int, enum_idx: StrMap_int) -> int:
    if b < 0:
        return 0
    sl = ast.nodes[b].kids
    for s in sl:
        k = ast.nodes[s].kind
        kids = ast.nodes[s].kids
        if k == "Assign":
            fix_ty_node(ast, kids[1], enum_idx)
        orif k == "If":
            fix_block_types(ast, kids[1], enum_idx)
            ol = ast.nodes[kids[2]].kids
            for o in ol:
                fix_block_types(ast, ast.nodes[o].kids[1], enum_idx)
            fix_block_types(ast, kids[3], enum_idx)
        orif k == "Until" or k == "While":
            fix_block_types(ast, kids[1], enum_idx)
        orif k == "Infinit" or k == "Thread":
            fix_block_types(ast, kids[0], enum_idx)
        orif k == "ForRange":
            fix_block_types(ast, kids[2], enum_idx)
        orif k == "ForEach":
            fix_block_types(ast, kids[1], enum_idx)
        orif k == "Try":
            fix_block_types(ast, kids[0], enum_idx)
            fix_block_types(ast, kids[1], enum_idx)
            fix_block_types(ast, kids[2], enum_idx)
    return 0

// Analyzes the desugared program in place. Diagnostics (analysis first, then the declaration
// pre-pass, as in Rust) go to `diags`. `org_*` map item names to their defining file for
// multi-file projects (may be empty). Returns true when the program is well typed.
make sema_program(ast: Ast, root: int, diags: Diags, require_main: bool, org_names: [string], org_files: [string], org_srcs: [string]) -> bool:
    s = Sema()
    s.ast = ast
    s.diags = Diags()
    s.pre = Diags()
    s.prog = root
    s.sig_idx = StrMap_int()
    s.struct_idx = StrMap_int()
    s.enum_idx = StrMap_int()
    s.org_idx = StrMap_int()
    s.gen_idx = StrMap_int()
    s.consts = StrMap_int()
    s.inst_idx = StrMap_int()
    s.org_files = org_files
    s.org_srcs = org_srcs
    oi = 0
    while oi < len(org_names):
        s.org_idx.set(org_names[oi], oi + 1)
        oi += 1

    structs_l = ast.nodes[root].kids[1]
    enums_l = ast.nodes[root].kids[2]
    fns_l = ast.nodes[root].kids[3]
    enum_nodes = ast.nodes[enums_l].kids
    s.structs_l = structs_l
    s.gstruct_idx = StrMap_int()
    struct_nodes: [int] = []
    for st0 in ast.nodes[structs_l].kids:
        if is_generic_struct(ast, st0):
            if s.gstruct_idx.has(ast.nodes[st0].text):
                s.perr("E0061", f"struct `{ast.nodes[st0].text}` is defined multiple times", ast.nodes[st0].span)
            else:
                append(s.gstruct_nodes, st0)
                s.gstruct_idx.set(ast.nodes[st0].text, len(s.gstruct_nodes))
        else:
            append(struct_nodes, st0)
    fn_nodes = ast.nodes[fns_l].kids

    // enums
    for e in enum_nodes:
        before = len(s.pre.items)
        ename = ast.nodes[e].text
        seen: [string] = []
        vnames: [string] = []
        vl = ast.nodes[ast.nodes[e].kids[0]].kids
        for v in vl:
            vn = ast.nodes[v].text
            if index_of_str(seen, vn) >= 0:
                s.perr("E0073", f"enum `{ename}` has a duplicate variant `{vn}`", ast.nodes[v].span)
            append(seen, vn)
            append(vnames, vn)
        if s.enum_idx.has(ename):
            s.perr("E0069", f"enum `{ename}` is defined multiple times", ast.nodes[e].span)
            ei = s.enum_idx.get(ename) - 1
            s.enums[ei].names = vnames
        else:
            et = EnumT()
            et.names = vnames
            append(s.enums, et)
            s.enum_idx.set(ename, len(s.enums))
        s.tag_from(s.pre, before, ename)
    sset = StrMap_int()
    for st in struct_nodes:
        sset.set(ast.nodes[st].text, 1)
    for e in enum_nodes:
        if sset.has(ast.nodes[e].text):
            s.perr("E0074", f"`{ast.nodes[e].text}` is defined as both a struct and an enum", ast.nodes[e].span)

    // resolve enum-typed names (only when there are enums)
    if len(enum_nodes) > 0:
        for st in struct_nodes:
            fl = ast.nodes[ast.nodes[st].kids[1]].kids
            for fd in fl:
                fix_ty_node(ast, ast.nodes[fd].kids[0], s.enum_idx)
        for f in fn_nodes:
            fk = ast.nodes[f].kids
            pl = ast.nodes[fk[0]].kids
            for p in pl:
                fix_ty_node(ast, ast.nodes[p].kids[0], s.enum_idx)
            fix_ty_node(ast, fk[1], s.enum_idx)
            fix_block_types(ast, fk[3], s.enum_idx)

    // generic records: replace every `Box<int>` in the non-generic code by its instance
    if len(s.gstruct_nodes) > 0:
        for st in struct_nodes:
            s.walk_resolve(st)
        for f in fn_nodes:
            if not is_generic_fn(ast, f):
                s.walk_resolve(f)

    // structs
    for st in struct_nodes:
        before2 = len(s.pre.items)
        sname = ast.nodes[st].text
        fl2 = ast.nodes[ast.nodes[st].kids[1]].kids
        sd = StructT()
        for fd in fl2:
            fty = ast.nodes[ast.nodes[fd].kids[0]].text
            ok = field_type_ok(fty)
            if not ok:
                s.pre.add("E0067", f"field `{ast.nodes[fd].text}` of struct `{sname}` has type `{ty_disp(fty)}`, but struct fields must be `int`/`float`/`bool`/`string` in Kite v0.1", ast.nodes[fd].span, "", "nested structs/collections are planned for v0.2")
            append(sd.names, ast.nodes[fd].text)
            append(sd.types, fty)
        if s.struct_idx.has(sname):
            si = s.struct_idx.get(sname) - 1
            s.structs[si] = sd
            s.perr("E0061", f"struct `{sname}` is defined multiple times", ast.nodes[st].span)
        else:
            append(s.structs, sd)
            s.struct_idx.set(sname, len(s.structs))
        s.tag_from(s.pre, before2, sname)

    // functions
    s.fns_l = fns_l
    for f in fn_nodes:
        if ast.nodes[ast.nodes[f].kids[2]].text == "const":
            s.consts.set(ast.nodes[f].text, 1)
    for f in fn_nodes:
        if is_generic_fn(ast, f):
            if s.gen_idx.has(ast.nodes[f].text):
                s.perr("E0036", f"function `{ast.nodes[f].text}` is defined multiple times", ast.nodes[f].span)
            else:
                append(s.gen_nodes, f)
                s.gen_idx.set(ast.nodes[f].text, len(s.gen_nodes))
            continue
        before3 = len(s.pre.items)
        fk = ast.nodes[f].kids
        fname = ast.nodes[f].text
        is_ext = is_extern_fn(ast, f)
        pl2 = ast.nodes[fk[0]].kids
        sig = SigT()
        for p in pl2:
            pty = ast.nodes[ast.nodes[p].kids[0]].text
            if is_ext and not is_scalar(pty):
                s.pre.add("E0038", f"extern parameter `{ast.nodes[p].text}` has type `{ty_disp(pty)}`, but `extern` functions may only take `int`/`float`/`bool`/`string`/`ptr<T>` parameters", ast.nodes[p].span, "", "pass a `ptr<T>` to C instead of a list/tuple/struct")
            append(sig.params, pty)
        if fk[1] >= 0:
            rt = ast.nodes[fk[1]].text
            if is_ext and not is_first_class_value(rt):
                s.perr("E0039", f"extern function `{fname}` may not return `{ty_disp(rt)}`", ast.nodes[f].span)
            sig.ret = rt
            sig.has_ret = true
        if is_ext and fk[1] < 0:
            sig.ret = "()"
            sig.has_ret = true
        if s.sig_idx.has(fname):
            gi = s.sig_idx.get(fname) - 1
            s.sigs[gi] = sig
            s.perr("E0036", f"function `{fname}` is defined multiple times", ast.nodes[f].span)
        else:
            append(s.sigs, sig)
            s.sig_idx.set(fname, len(s.sigs))
        s.tag_from(s.pre, before3, fname)

    if require_main and not s.sig_idx.has("main"):
        s.pre.add("E0037", "no `main` function found", span_dummy(), "", "every Kite program needs a `make main():` entry point")

    for f in fn_nodes:
        if is_generic_fn(ast, f):
            continue
        before4 = len(s.diags.items)
        s.check_function(f)
        // (`ast` is a stale copy of the arena header once instances have been added: read through `s.ast`)
        s.tag_from(s.diags, before4, s.ast.nodes[f].text)
    // instances of generic functions created while checking (they may create further instances)
    ast.nodes = s.ast.nodes
    pk = 0
    while pk < len(s.pending):
        pf = s.pending[pk]
        before5 = len(s.diags.items)
        s.check_function(pf)
        s.tag_from(s.diags, before5, s.ast.nodes[pf].text)
        ast.nodes = s.ast.nodes
        pk += 1
    for d in s.pre.items:
        append(s.diags.items, d)

    if len(s.diags.items) > 0:
        for d in s.diags.items:
            append(diags.items, d)
        return false

    // the typed program: infer-and-store non-void return types
    for f in fn_nodes:
        if is_generic_fn(ast, f):
            continue
        fk = ast.nodes[f].kids
        if fk[1] < 0 and not is_extern_fn(ast, f):
            gi2 = s.sig_idx.get(ast.nodes[f].text) - 1
            if s.sigs[gi2].has_ret and s.sigs[gi2].ret != "()":
                tid = s.ast.add0("Type", s.sigs[gi2].ret, ast.nodes[f].span)
                s.ast.nodes[f].kids[1] = tid
    // generic records leave the program; their instances (appended while checking) stay
    if len(s.gstruct_nodes) > 0:
        live_s: [int] = []
        for st1 in s.ast.nodes[structs_l].kids:
            if not is_generic_struct(s.ast, st1):
                append(live_s, st1)
        s.ast.nodes[structs_l].kids = live_s
    // generic functions leave the program; their instances join it
    if len(s.gen_nodes) > 0 or len(s.pending) > 0:
        live: [int] = []
        for f in fn_nodes:
            if not is_generic_fn(ast, f):
                append(live, f)
        for pf2 in s.pending:
            append(live, pf2)
        s.ast.nodes[fns_l].kids = live
    // `Sema.ast` is a copy of the arena header: hand the grown node list back
    ast.nodes = s.ast.nodes
    return true

make org_none() -> [string]:
    out: [string] = []
    return out
